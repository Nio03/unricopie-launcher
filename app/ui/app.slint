// La ventana de Unricopie, con el diseño v3 (aprobado el 1-11): arriba las secciones, a la
// izquierda tu biblioteca y en el centro las cajas, con la franja de su consola y la portada
// real. Los datos llegan de Rust (src/main.rs); aquí solo se dibujan.
//
// Idiomas: todo texto va en @tr(), escrito en español; el inglés está en lang/en/LC_MESSAGES/
// unricopie.po y va dentro del ejecutable (build.rs). Desde Rust llegan datos y códigos, no frases.
import { ScrollView } from "std-widgets.slint";
import { Paleta, Tema } from "tema.slint";

export { Paleta, Tema }

export enum Vista { biblioteca, explorar, mods, descargas, ajustes, juego, ficha-mod }

// Una versión anterior guardada de un juego instalado: se puede volver a ella.
export struct Anterior {
    id: string,
    version: string,
    // Cuándo se instaló esa copia y cuándo se guardó (al actualizar o al cambiar), ya escritos:
    // dos copias de la misma versión se distinguen por eso.
    instalada: string,
    guardada: string,
    // Un mod activo que pide una versión del juego más nueva que esta, cuál pide y cuántos más.
    aviso-mod: string,
    aviso-min: string,
    aviso-mas: int,
}

// Un proyecto que lleva el juego a PC (una ficha del catálogo con su receta).
export struct Proyecto {
    entry: string,
    nombre: string,
    // Cómo llega a PC: recomp, decomp-port, fan-remake, native-layer, game-engine o source-port.
    metodo: string,
    toolchain: string,
    autor: string,
    repo: string,
    // 0 totalmente jugable, 1 jugable, 2 experimental: el texto y el color los pone la ventana.
    nivel: int,
    recomendado: bool,
    // Ya en el idioma elegido; vacío si la ficha no lo tiene en ese idioma.
    motivo: string,
    // La descripción del proyecto (la de su ficha).
    desc: string,
    // Sus estrellas en GitHub, ya escritas («7.625»); vacío si no se saben.
    estrellas: string,
    requisitos: string,
    // Tu copia: 0 no hace falta, 1 la pide su instalador, 2 comprobada, 3 guardada sin comprobar,
    // 4 todavía no la elegiste.
    copia: int,
    // La copia aceptada con la que coincide la tuya.
    copia-nombre: string,
    // Está instalado y le falta la copia.
    copia-falta: bool,
    // Unricopie puede pedirla, comprobarla y guardarla.
    pide-copia: bool,
    // Se da como carpeta (los archivos del juego original), no como archivo.
    copia-carpeta: bool,
    // La receta dice qué abrir en esta plataforma: se puede instalar.
    instalable: bool,
    // Unricopie tiene receta (si no, se lleva a la página del proyecto).
    con-receta: bool,
    // Su receta dice de dónde salen sus mods y dónde van.
    con-mods: bool,
    // Sin enlace por prudencia: ni GitHub ni instalación.
    sin-enlace: bool,
    instalado: bool,
    // Está en la cola de descargas o bajándose.
    bajando: bool,
    version: string,
    // La última versión oficial, si no es la instalada; vacío si está al día o no se sabe.
    nueva: string,
    // La última release del proyecto según el catálogo, y su fecha ya escrita.
    ultima: string,
    fecha-ultima: string,
    // Las versiones anteriores guardadas, la más reciente primero (solo en el juego abierto).
    anteriores: [Anterior],
    // Desde cuándo está la instalada, ya escrito; la versión guardada a la que se está pasando
    // (vacío si no), y el aviso de mods para la instalada (como en `Anterior`).
    instalada-el: string,
    cambiando: string,
    aviso-mod: string,
    aviso-min: string,
    aviso-mas: int,
    // 0 estable, 1 sin probar, 2 nightly.
    canal: int,
    carpeta: string,
    portable: bool,
    // Las opiniones de la gente sobre este proyecto (recompendium.com/reportes.json).
    op-total: int,
    op-bien: int,
    op-problemas: int,
    op-no: int,
    // Esta versión ya se abrió una vez («No arranca» se puede marcar), y ya tiene una hora de
    // juego o pasó un día desde entonces (también «Funciona bien» y «Con problemas»).
    op-abierto: bool,
    op-listo: bool,
}

// Un error del núcleo, como datos (src/errores.rs): la frase la escribe Util.error.
export struct ErrorUi {
    codigo: int,
    a: string,
    b: string,
    c: string,
    n: int,
}

// Una descarga de la cola.
export struct Descarga {
    // Es un mod (de `autor`, desde Thunderstore) y no un juego.
    es-mod: bool,
    // Es la versión nueva de un juego ya instalado.
    actualiza: bool,
    autor: string,
    entry: string,
    juego-id: string,
    titulo: string,
    juego: string,
    // 0 en cola, 1 bajando, 2 descomprimiendo, 3 hecha, 4 falló.
    fase: int,
    // Tamaños ya escritos («2,2 GB»), y el error si lo hubo (código 0: ninguno).
    bajado: string,
    total: string,
    error: ErrorUi,
    // De 0 a 1; negativo si no se sabe el total.
    progreso: float,
    portada: image,
    con-arte: bool,
    color: color,
}

export struct Juego {
    id: string,
    // Cuántos mods hay en Thunderstore para él, si Unricopie sabe ponérselos (si no, 0).
    mods: int,
    nombre: string,
    consola-nombre: string,
    color: color,
    tinta: color,
    desarrollador: string,
    anio: int,
    // Ya en el idioma elegido.
    desc: string,
    portada: image,
    fondo: image,
    logo: image,
    icono: image,
    // Capturas del juego (solo en el juego abierto).
    capturas: [image],
    // Hay portada; el fondo y el logo pueden faltar (IGDB no tiene logos).
    con-arte: bool,
    con-fondo: bool,
    con-logo: bool,
    // De dónde es el arte: 0 de ningún sitio, 1 SteamGridDB (con sus autores), 2 IGDB.
    arte: int,
    arte-portada: string,
    arte-fondo: string,
    arte-logo: string,
    arte-icono: string,
    instalado: bool,
    // El nivel del proyecto que se muestra primero.
    nivel: int,
    // Lo que va bajo la caja en la biblioteca: el proyecto y su versión.
    sub: string,
    proyectos: [Proyecto],
}

// Los textos que dependen de un código, en el idioma elegido.
// La respuesta al ratón: rápida al entrar, igual que en Steam.
global Mov {
    out property <duration> rapido: 90ms;
    out property <duration> normal: 140ms;
}

// Una variante de un mod (los .rtz de Modern Controller Overhaul, uno por mando).
export struct Variante {
    archivo: string,
    nombre: string,
    activa: bool,
}

// Un mod instalado (o bajándose), en la pestaña Mods.
export struct ModFila {
    id: string,
    nombre: string,
    autor: string,
    version: string,
    // Su lugar en el orden de carga (1, 2…), o 0 si está apagado.
    orden: int,
    activo: bool,
    // Falso mientras se baja.
    instalado: bool,
    desc: string,
    // Los mods activos que lo piden («Modern Controller Overhaul»).
    pide: string,
    // La versión nueva que hay en Thunderstore, si la hay.
    nueva: string,
    variantes: [Variante],
    // Trae variantes y no hay ninguna elegida.
    falta-elegir: bool,
    probado: bool,
    // Como Descarga: -1 nada, 0 en cola, 1 bajando, 2 descomprimiendo.
    fase: int,
    progreso: float,
    pagina: string,
    // Lo añadió el jugador a mano (soltándolo o con «Añadir desde archivo…»).
    local: bool,
}

// Un mod de la lista de Thunderstore.
export struct ModRemoto {
    id: string,
    nombre: string,
    autor: string,
    version: string,
    desc: string,
    descargas: string,
    tam: string,
    biblioteca: bool,
    // 0 se puede instalar, 1 instalado, 2 en Descargas, 3 hay versión nueva, 4 el juego no está
    // instalado (Explorar lleva a su página).
    estado: int,
    pagina: string,
    // De qué juego es (en Explorar): su id, su nombre, el proyecto y los colores de su consola.
    juego-id: string,
    juego: string,
    entry: string,
    color: color,
    tinta: color,
    // La dirección de su icono en Thunderstore: la clave con que se pide a `Iconos`.
    icono: string,
}

// Una opción de la columna de filtros de «Ver todos».
export struct OpcionFiltro {
    clave: string,
    // El nombre si viene de los datos (consolas, juegos); vacío si lo escribe la ventana
    // (Util.filtro-opcion).
    nombre: string,
    color: color,
    // 0 nada, 1 el cuadrado de la consola, 2 el punto del estado.
    marca: int,
    cuenta: int,
    marcada: bool,
}

// Un grupo de la columna de filtros: Consola, Estado, Unricopie; en Mods, Juego, Tipo, Unricopie.
export struct GrupoFiltro {
    clave: string,
    opciones: [OpcionFiltro],
}

// Un estante del inicio de Explorar: el título, cuántos hay en total y los primeros.
export struct EstanteJuegos {
    grupo: string,
    clave: string,
    titulo: string,
    color: color,
    con-color: bool,
    cuenta: int,
    juegos: [Juego],
}

export struct EstanteMods {
    grupo: string,
    clave: string,
    titulo: string,
    color: color,
    con-color: bool,
    cuenta: int,
    mods: [ModRemoto],
}

// Un problema del orden de los mods (solver.rs): la frase la escribe Util.problema-mod.
export struct ProblemaMod {
    codigo: int,
    a: string,
    b: string,
    c: string,
    d: string,
    // 0 nada, 1 instalarla, 2 activarla, 3 actualizarla, 4 que gane `e` (el mod `id`).
    accion: int,
    id: string,
    // Un nombre más para el botón (el de «Que gane») y la segunda acción: 5 que siga ganando `b`
    // (el mod `id2`).
    e: string,
    accion2: int,
    id2: string,
    // Todos los mods del conflicto, separados por «|».
    ids: string,
}

// La pestaña Mods: la llena Rust (src/main.rs, `mostrar_mods`) y recibe lo que hace el jugador.
export global ModsUi {
    // El proyecto cuyos mods se muestran.
    in property <string> entry;
    // Ya llegó cómo están (del hilo de los mods).
    in property <bool> cargado;
    // El juego está instalado: se le pueden poner mods.
    in property <bool> instalado;
    in property <string> comunidad;
    in property <string> carpeta;
    in property <string> perfil;
    in property <[string]> perfiles;
    in property <int> perfil-indice;
    in property <[ModFila]> filas;
    // Cuántos están activos y en el orden.
    in property <int> activos;
    in property <[ProblemaMod]> problemas;
    in property <ErrorUi> error;
    // La lista de Thunderstore: 0 leyéndose, 1 lista, 2 no se pudo leer.
    in property <int> lista;
    in property <int> total;
    // Las primeras de la búsqueda (se dibujan de a 50) y cuántas coinciden en total.
    in property <[ModRemoto]> remotos;
    in property <int> coinciden;
    // Se ve la lista de Thunderstore («Buscar mods») en vez de la tuya.
    in-out property <bool> buscando;
    // En la última orden: cambios del menú del juego que se adoptaron y mods propios añadidos.
    in property <int> adoptados;
    in property <int> anadidos;
    // Ordenar a mano: mover un mod junto a otro (después, con el `bool`), un lugar arriba o abajo
    // (-1 o +1), y que gane uno en un conflicto (el mod y todos los del conflicto, con «|»).
    callback mover(string, string, bool);
    callback correr(string, int);
    callback preferir(string, string);
    callback anadir-archivo();
    // Lo que lleva una fila al arrastrarla: su id (lo arma Rust; en Slint el tipo es opaco y un
    // DragArea sin dato no arranca).
    pure callback dato-arrastre(string) -> data-transfer;
    callback ver(string);
    callback activar(string, bool);
    callback variante(string, string, bool);
    callback quitar(string);
    callback instalar(string);
    callback buscar(string);
    callback recargar();
    // «Ver más»: 50 más de la búsqueda.
    callback mas();
    callback perfil-elegir(string);
    callback perfil-nuevo(string, bool);
    callback perfil-renombrar(string);
    callback perfil-borrar();
}

// La ficha de un mod dentro de Unricopie, encima de lo que se esté viendo: los datos de la lista
// de Thunderstore y su README (que pide Rust). Thunderstore queda como enlace externo.
// Un mod al que lleva la ficha de otro (lo que necesita o lo que lo usa).
export struct ModEnlace {
    id: string,
    nombre: string,
    autor: string,
    // La versión que pide o la que tiene.
    detalle: string,
    icono: string,
    // Está en la lista de Thunderstore de este juego: se puede abrir su ficha.
    en-lista: bool,
}

// Una versión publicada de un mod.
export struct VersionMod {
    version: string,
    fecha: string,
    descargas: string,
    tam: string,
}

// Un trozo de un README: 0 párrafo o lista (con estilo y enlaces), 1-3 título, 4 código, 5 raya.
export struct BloqueMd {
    tipo: int,
    texto: styled-text,
    plano: string,
}

export global FichaMod {
    in property <ModRemoto> r;
    // Autor-Nombre-versión, como lo escribe Thunderstore.
    in property <string> paquete;
    in property <string> autor-url;
    in property <string> web;
    in property <string> actualizado;
    in property <string> subido;
    in property <string> me-gusta;
    in property <string> categorias;
    in property <[ModEnlace]> necesita;
    in property <[ModEnlace]> lo-usan;
    in property <[VersionMod]> versiones;
    // El README y el registro de cambios: 0 leyéndose, 1 listo, 2 no se pudo leer o no hay.
    in property <[BloqueMd]> bloques;
    in property <int> estado-readme;
    in property <[BloqueMd]> cambios;
    in property <int> estado-cambios;
    // 0 Descripción, 1 Necesita, 2 Lo usan, 3 Versiones, 4 Cambios.
    in-out property <int> pestana;
    callback abrir(string, string);
    // Una dirección https de fuera (la web del autor, un enlace del README).
    callback abrir-web(string);
}

// Explorar, como Nexus Mods: al entrar, estantes; «Ver todos» abre la cuadrícula con la columna
// de filtros y «Ordenar». En modo Juegos o Mods. Lo llena Rust (`mostrar_explorar`): los estantes
// solo en el inicio y la cuadrícula solo en «Ver todos».
export global ExplorarUi {
    in-out property <bool> mods;
    in-out property <bool> todos;
    in property <[EstanteJuegos]> estantes;
    in property <[EstanteMods]> estantes-mods;
    in property <[Juego]> juegos;
    in property <[ModRemoto]> filas;
    in property <[GrupoFiltro]> filtros;
    in property <int> resultados;
    in property <int> orden;
    // Hay algún filtro marcado o algo buscado.
    in property <bool> filtrado;
    // Mods: cuántos hay, de cuántos juegos, y si falta alguna lista de Thunderstore.
    in property <int> total-mods;
    in property <int> juegos-mods;
    in property <bool> cargando;
    callback modo(bool);
    // Desde un estante: abre «Ver todos» con ese filtro marcado (grupo y clave; vacíos: sin filtro).
    callback ver-todos(string, string);
    callback volver();
    callback marcar(string, string, bool);
    callback limpiar();
    callback ordenar(int);
    callback buscar(string);
    callback instalar(string, string);
    callback ver-juego(string, string);
}

// Los iconos de los mods, a demanda: Rust los lee del disco o los baja de Thunderstore. `listos`
// cambia cuando llegan iconos nuevos, para que las tarjetas los vuelvan a pedir.
export global Iconos {
    in property <int> listos;
    pure callback icono(string, int) -> image;
}

// Las portadas, a demanda: cada caja visible pide la suya y Rust la lee del disco con una
// caché limitada. Así, con mil juegos, solo se decodifican las que se ven.
export global Portadas {
    pure callback portada(string) -> image;
}

export global Util {
    public pure function nivel-color(n: int) -> color {
        return n == 0 ? Paleta.ok : n == 1 ? Paleta.warn : Paleta.night;
    }
    public pure function estado(n: int) -> string {
        return n == 0 ? @tr("Totalmente jugable") : n == 1 ? @tr("Jugable") : @tr("Experimental");
    }
    // Los mismos textos que el sitio (src/i18n/ui.ts, «Cómo llega a PC»).
    pure function metodo-base(m: string) -> string {
        return m == "recomp" ? @tr("Recompilación estática")
            : m == "decomp-port" ? @tr("Port de una decompilación")
            : m == "fan-remake" ? @tr("Reimplementación de fans")
            : m == "native-layer" ? @tr("Capa nativa")
            : m == "game-engine" ? @tr("Motor hecho para el juego")
            : m == "source-port" ? @tr("Port del código fuente liberado")
            : "";
    }
    public pure function metodo(m: string, t: string) -> string {
        return t == "" ? metodo-base(m) : metodo-base(m) == "" ? @tr("Con {}", t) : @tr("{}, con {}", metodo-base(m), t);
    }
    public pure function canal(c: int) -> string {
        return c == 0 ? @tr("estable") : c == 1 ? @tr("sin probar") : @tr("nightly");
    }
    public pure function copia(c: int, nombre: string) -> string {
        return c == 0 ? @tr("No hace falta")
            : c == 1 ? @tr("La pide su propio instalador")
            : c == 2 ? (nombre != "" ? @tr("Comprobada: {}", nombre) : @tr("Comprobada"))
            : c == 3 ? @tr("Guardada, sin comprobar")
            : @tr("Todavía no la elegiste");
    }
    public pure function descarga(d: Descarga) -> string {
        return d.fase == 0 ? @tr("En cola")
            : d.fase == 1 ? (d.total != "" ? @tr("{} de {}", d.bajado, d.total) : d.bajado != "" ? d.bajado : @tr("Empezando"))
            : d.fase == 2 ? @tr("Bajado. Comprobando y descomprimiendo…")
            : d.fase == 3 && d.es-mod ? @tr("Instalado y puesto en el juego.")
            : d.fase == 3 && d.actualiza ? @tr("Actualizado. La versión de antes quedó guardada, con tus partidas.")
            : d.actualiza && d.fase == 4 ? @tr("No se pudo actualizar: {}. Sigue la versión que tenías.", error(d.error))
            : d.fase == 3 ? (d.error.codigo == 0 ? @tr("Instalado. Ya está en tu biblioteca.") : @tr("Instalado, pero no se pudo hacer portable: {}", error(d.error)))
            : @tr("No se pudo instalar: {}", error(d.error));
    }
    // La columna de filtros: el título de cada grupo y el nombre de las opciones que no vienen de
    // los datos.
    public pure function filtro-grupo(g: string) -> string {
        return g == "consola" ? @tr("Consola")
            : g == "estado" ? @tr("Estado")
            : g == "unricopie" ? @tr("Unricopie")
            : g == "juego" ? @tr("Juego")
            : g == "tipo" ? @tr("Tipo")
            : g;
    }
    public pure function filtro-opcion(g: string, o: OpcionFiltro) -> string {
        return o.nombre != "" ? o.nombre
            : g == "estado" && o.clave == "0" ? @tr("Totalmente jugable")
            : g == "estado" && o.clave == "1" ? @tr("Jugable")
            : g == "estado" && o.clave == "2" ? @tr("Experimental")
            : o.clave == "instalables" ? @tr("Se instala aquí")
            : o.clave == "instalados" ? @tr("Instalados")
            : o.clave == "mis-juegos" ? @tr("Para tus juegos")
            : o.clave == "mods" ? @tr("Mods")
            : o.clave == "libraries" ? @tr("Bibliotecas")
            : o.clave == "modpacks" ? @tr("Paquetes de mods")
            : o.clave == "audio" ? @tr("Audio")
            : o.clave == "tools" ? @tr("Herramientas")
            : o.clave == "misc" ? @tr("Varios")
            : o.clave;
    }
    public pure function estante(clave: string, titulo: string) -> string {
        return clave == "instalables" ? @tr("Se instalan con Unricopie")
            : clave == "mas-bajados" ? @tr("Los más bajados")
            : titulo;
    }
    // Un problema de los mods (ProblemaMod): a y b son mods; en el conflicto de archivos, b gana.
    public pure function problema-mod(p: ProblemaMod) -> string {
        return p.codigo == 1 ? (p.c == "" ? @tr("{} necesita {}, que no está instalado.", p.a, p.b) : @tr("{} necesita {} ({}), que no está instalado.", p.a, p.b, p.c))
            : p.codigo == 2 ? @tr("{} necesita {}, que está apagado en este perfil.", p.a, p.b)
            : p.codigo == 3 ? @tr("{} pide {} {} y tienes la {}.", p.a, p.b, p.c, p.d)
            : p.codigo == 4 ? @tr("{} y {} no pueden ir juntos: {}", p.a, p.b, p.c)
            : p.codigo == 5 ? @tr("Las reglas de orden de {} se contradicen.", p.a)
            : @tr("{0} y {1} traen los mismos archivos (por ejemplo {2}): gana {1}, que carga después.", p.a, p.b, p.d);
    }
    public pure function arte(j: Juego) -> string {
        return j.arte == 1 ? @tr("Portada de {}, fondo de {}, logo de {} e icono de {}, en SteamGridDB", j.arte-portada, j.arte-fondo, j.arte-logo, j.arte-icono)
            : j.con-fondo ? @tr("Portada y fondo de IGDB")
            : @tr("Portada de IGDB");
    }
    // Lo último que pasó con el juego abierto. Los códigos los pone Rust (main.rs, `Aviso`).
    // Los errores del núcleo (los códigos de src/errores.rs).
    public pure function error(e: ErrorUi) -> string {
        return e.codigo == 1 ? @tr("no se pudo usar {}: {}", e.a, e.b)
            : e.codigo == 2 ? @tr("no se pudo descomprimir {}: {}", e.a, e.b)
            : e.codigo == 3 ? @tr("el archivo trae una ruta no permitida: {}", e.a)
            : e.codigo == 4 ? @tr("lo descomprimido supera el límite de {} bytes", e.a)
            : e.codigo == 5 ? @tr("el archivo trae más de {} archivos", e.a)
            : e.codigo == 6 ? @tr("la descarga no coincide: se esperaba el {} {} y llegó {}", e.a, e.b, e.c)
            : e.codigo == 7 ? @tr("enlace no válido: {}", e.a)
            : e.codigo == 8 ? @tr("error de red en {}: {}", e.a, e.b)
            : e.codigo == 9 ? @tr("una respuesta no es JSON válido: {}", e.a)
            : e.codigo == 10 ? @tr("la receta de este juego tiene un error. Es cosa nuestra, no tuya.")
            : e.codigo == 11 ? @tr("no hay versión para {}", e.a)
            : e.codigo == 12 ? @tr("{} no tiene ninguna versión en el canal {}", e.a, canal(e.n))
            : e.codigo == 13 ? @tr("la versión {} no trae ningún archivo que encaje con «{}»", e.a, e.b)
            : e.codigo == 14 ? @tr("la versión {} trae varios archivos que encajan con «{}»: {}", e.a, e.b, e.c)
            : e.codigo == 15 ? @tr("después de instalar no aparece {}", e.a)
            : e.codigo == 16 ? @tr("ya hay algo instalado en {}", e.a)
            : e.codigo == 17 ? @tr("todavía no se sabe instalar {} ({})", e.a, e.b)
            : e.codigo == 18 ? @tr("{} ya trae un unricopie.json", e.a)
            : e.codigo == 19 ? @tr("el paquete tiene una forma inesperada: {}", e.a)
            : e.codigo == 20 ? @tr("no hay nada instalado en {}", e.a)
            : e.codigo == 21 ? @tr("lo que hay en {} no lo instaló Unricopie", e.a)
            : e.codigo == 22 ? @tr("en {} está instalado {}, que es otro juego", e.a, e.b)
            : e.codigo == 23 ? @tr("ya está instalada la versión {}", e.a)
            : e.codigo == 24 ? @tr("el juego está abierto: ciérralo antes")
            : e.codigo == 25 ? @tr("no hay una versión anterior «{}»", e.a)
            : e.codigo == 26 ? @tr("la receta no dice cómo hacerlo portable en {}", e.a)
            : e.codigo == 27 ? @tr("no se puede crear {}: ya hay otra cosa con ese nombre", e.a)
            : e.codigo == 28 ? @tr("no se pudo usar la configuración {}: {}", e.a, e.b)
            : e.codigo == 29 ? @tr("la configuración {} no está en UTF-8", e.a)
            : e.codigo == 30 ? @tr("la configuración {} no tiene la forma esperada", e.a)
            : e.codigo == 31 ? @tr("en la configuración {}, «{}» no es una sección", e.a, e.b)
            : e.codigo == 32 ? @tr("el valor no cabe en la configuración {}", e.a)
            : e.codigo == 33 ? @tr("no se puede abrir {}: {}", e.a, e.b)
            : e.codigo == 34 ? @tr("la receta no dice qué ejecutable abrir")
            : e.codigo == 35 ? @tr("abrir apps de macOS todavía no se hace")
            : e.codigo == 36 ? @tr("no está {}", e.a)
            : e.codigo == 37 ? @tr("tu copia no es ninguna de las que acepta este proyecto")
            : e.codigo == 38 ? @tr("a tu copia le falta {}", e.a)
            : e.codigo == 39 ? @tr("{} no es una ROM de N64", e.a)
            : e.codigo == 40 ? @tr("este proyecto pide un archivo, no una carpeta")
            : e.codigo == 41 ? @tr("este proyecto pide la carpeta del juego")
            : e.codigo == 42 ? @tr("los dmg solo se abren en macOS")
            : e.codigo == 43 ? @tr("{} no es un juego de la biblioteca", e.a)
            : e.codigo == 44 ? @tr("no se encuentra la carpeta de datos del sistema")
            : e.codigo == 45 ? @tr("el antivirus del sitio marcó {}", e.a)
            : e.codigo == 46 ? @tr("este sistema todavía no tiene versión")
            : e.codigo == 47 ? @tr("{} no trae nada que el juego use como mod", e.a)
            : "";
    }
    public pure function aviso(c: int, a: string, e: ErrorUi) -> string {
        return c == 1 ? @tr("Está en Descargas: se baja la última release oficial, comprobando su hash.")
            : c == 2 ? @tr("La cola de descargas no responde.")
            : c == 3 ? @tr("Preparando {}…", a)
            : c == 4 ? @tr("Comprobando tu copia…")
            : c == 5 ? (a != "" ? @tr("Tu copia está comprobada y guardada: {}.", a) : @tr("Tu copia está comprobada y guardada."))
            : c == 6 ? @tr("Tu copia está guardada. La receta no trae con qué comprobarla.")
            : c == 7 ? @tr("No es ninguna de las copias que acepta este proyecto. No se guardó.")
            : c == 8 ? @tr("No se pudo guardar tu copia: {}", error(e))
            : c == 9 ? @tr("Abriendo {}.", a)
            : c == 10 ? @tr("Abriendo {}: todavía no elegiste tu copia, así que el juego te la pedirá.", a)
            : c == 11 ? @tr("Abriendo {}: se volvió a apagar su actualizador.", a)
            : c == 12 ? @tr("Abriendo {}: todavía no elegiste tu copia, así que el juego te la pedirá; y se volvió a apagar su actualizador.", a)
            : c == 13 ? @tr("No se pudo abrir {}: {}", a, error(e))
            : c == 14 ? @tr("Volviste a la versión {}. La que tenías quedó guardada en Versiones.", a)
            : c == 15 ? @tr("No se pudo volver a la versión {}: {}", a, error(e))
            : c == 16 ? @tr("Se borró la versión {}.", a)
            : c == 17 ? @tr("No se pudo borrar la versión {}: {}", a, error(e))
            : "";
    }
    public pure function aviso-mal(c: int) -> bool {
        return c == 2 || c == 7 || c == 8 || c == 13 || c == 15 || c == 17;
    }
}

component Punto inherits Rectangle {
    in property <color> c;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.c;
}

// Una sección de la barra de arriba, o una pestaña de la página del juego.
component Pestana inherits Rectangle {
    in property <string> text;
    in property <bool> activa;
    in property <length> tamano: 14.25px;
    // Un número pequeño al lado, si es mayor que cero (los mods instalados).
    in property <int> cuenta;
    callback clicked;
    // Al pasar el ratón, un fondo suave; al pulsar, un poco más.
    background: ta.pressed ? Paleta.panel-2 : ta.has-hover && !root.activa ? Paleta.panel : transparent;
    animate background { duration: Mov.rapido; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        Text {
            text: root.text;
            color: root.activa || ta.has-hover ? Paleta.fg : Paleta.fg-2;
            font-size: root.tamano;
            font-weight: 700;
            vertical-alignment: center;
            animate color { duration: Mov.rapido; }
        }
        if root.cuenta > 0: Text {
            text: root.cuenta;
            color: Paleta.fg-3;
            font-size: root.tamano * 0.86;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
    Rectangle {
        y: parent.height - 3px;
        height: 3px;
        background: root.activa ? Paleta.gold : ta.pressed ? Paleta.gold.with-alpha(0.5) : transparent;
        animate background { duration: Mov.normal; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Buscador inherits Rectangle {
    in property <string> placeholder;
    // El texto, por si hay que conservarlo cuando el buscador desaparece y vuelve.
    in-out property <string> text <=> input.text;
    callback edited(string);
    height: 32px;
    border-radius: 6px;
    background: Paleta.panel;
    border-width: Paleta.bw;
    border-color: input.has-focus ? Paleta.gold : Paleta.line;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Path {
                width: 14px;
                height: 14px;
                viewbox-width: 16;
                viewbox-height: 16;
                commands: "M 12 7 A 5 5 0 1 1 2 7 A 5 5 0 1 1 12 7 Z M 11 11 L 14.5 14.5";
                stroke: Paleta.fg-3;
                stroke-width: 1.8px;
            }
        }
        Rectangle {
            input := TextInput {
                color: Paleta.fg;
                font-size: 13px;
                vertical-alignment: center;
                single-line: true;
                edited => { root.edited(self.text); }
            }
            Text {
                visible: input.text == "";
                text: root.placeholder;
                color: Paleta.fg-3;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-alignment: left;
                width: parent.width;
            }
        }
    }
}

// Una fila de la barra lateral: icono, nombre y el cuadradito de la consola.
component Fila inherits Rectangle {
    in property <Juego> juego;
    in property <bool> actual;
    callback clicked;
    height: 30px;
    border-radius: 5px;
    background: ta.pressed ? Paleta.line : root.actual ? Paleta.panel-2 : ta.has-hover ? Paleta.panel : transparent;
    animate background { duration: Mov.rapido; }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 9px;
        VerticalLayout {
            alignment: center;
            if root.juego.con-arte: Image {
                width: 20px;
                height: 20px;
                source: Portadas.portada(root.juego.id);
                image-fit: cover;
            }
            if !root.juego.con-arte: Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 3px;
                background: root.juego.color.darker(0.6);
            }
        }
        Text {
            text: root.juego.nombre;
            color: root.actual || ta.has-hover ? Paleta.fg : Paleta.fg-2;
            font-size: 13.2px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            animate color { duration: Mov.rapido; }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 2px;
                background: root.juego.color;
            }
        }
    }
    // El borde de la izquierda, del color de la consola, marca el juego abierto.
    Rectangle {
        x: 0;
        width: 3px;
        background: root.actual ? root.juego.color : transparent;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// La caja: franja de la consola arriba y la portada real, como en la estantería.
component Caja inherits Rectangle {
    in property <Juego> juego;
    in property <string> sub;
    in property <bool> con-punto;
    in property <color> punto;
    callback clicked;
    // Al pasar el ratón la caja se levanta, con sombra y el marco dorado; al pulsar, se hunde.
    property <bool> encima: ta.has-hover && !ta.pressed;
    VerticalLayout {
        spacing: 7px;
        alignment: start;
        // El hueco de la caja; la caja de verdad va dentro, para poder levantarla.
        hueco := Rectangle {
            height: 19px + root.width * 1.5;
            caja := Rectangle {
                y: root.encima ? -4px : ta.pressed ? 1px : 0;
                height: parent.height;
                border-radius: 4px;
                background: Paleta.panel;
                drop-shadow-color: #00000090;
                drop-shadow-offset-y: root.encima ? 8px : 0;
                drop-shadow-blur: root.encima ? 18px : 0;
                animate y, drop-shadow-offset-y, drop-shadow-blur { duration: Mov.normal; easing: ease-out; }
                Rectangle {
                    border-radius: 4px;
                    clip: true;
                    VerticalLayout {
                        Rectangle {
                            height: 19px;
                            background: root.juego.color;
                            Text {
                                x: 7px;
                                width: parent.width - 14px;
                                text: root.juego.consola-nombre;
                                color: root.juego.tinta;
                                font-size: 9.9px;
                                font-weight: 800;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        Rectangle {
                            clip: true;
                            if root.juego.con-arte: Image {
                                width: parent.width;
                                height: parent.height;
                                source: Portadas.portada(root.juego.id);
                                image-fit: cover;
                                // La portada se acerca un poco, como en Steam.
                                transform-origin: { x: self.width / 2, y: self.height / 2 };
                                transform-scale-x: root.encima ? 104% : 100%;
                                transform-scale-y: root.encima ? 104% : 100%;
                                animate transform-scale-x, transform-scale-y { duration: Mov.normal; easing: ease-out; }
                            }
                            // Sin portada: el color de la consola y el nombre, como una caja sin arte.
                            if !root.juego.con-arte: Rectangle {
                                background: @linear-gradient(160deg, root.juego.color.darker(0.5) 0%, root.juego.color.darker(2.4) 100%);
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 3px;
                                    alignment: end;
                                    Text {
                                        text: root.juego.nombre;
                                        color: #ffffff;
                                        font-size: 14px;
                                        font-weight: 800;
                                        wrap: word-wrap;
                                    }
                                    if root.juego.anio > 0: Text {
                                        text: root.juego.anio;
                                        color: #ffffffb8;
                                        font-size: 11.5px;
                                        font-weight: 600;
                                    }
                                }
                            }
                            // Encima de la portada (o del color, si no hay), abajo a la derecha para no
                            // tapar el nombre ni el año: cuántos mods tiene.
                            if root.juego.mods > 0: Rectangle {
                                x: parent.width - self.width - 6px;
                                y: parent.height - self.height - 6px;
                                height: 18px;
                                width: tm.preferred-width + 12px;
                                border-radius: 4px;
                                background: #000000b8;
                                tm := Text {
                                    text: @tr("{} mods", root.juego.mods);
                                    color: #ffffff;
                                    font-size: 10.5px;
                                    font-weight: 700;
                                }
                            }
                        }
                    }
                }
                // El marco: una línea fina, dorada y más gruesa al pasar por encima.
                Rectangle {
                    border-radius: 4px;
                    border-width: ta.has-hover ? 2px : Paleta.bw;
                    border-color: ta.has-hover ? Paleta.gold : Paleta.line;
                    animate border-color { duration: Mov.rapido; }
                }
            }
        }
        Text {
            text: root.juego.nombre;
            color: ta.has-hover ? Paleta.resalte : Paleta.fg;
            font-size: 12.9px;
            font-weight: 700;
            wrap: word-wrap;
            overflow: elide;
            height: Math.min(self.preferred-height, 30px);
            animate color { duration: Mov.rapido; }
        }
        HorizontalLayout {
            spacing: 6px;
            if root.con-punto: VerticalLayout {
                alignment: center;
                Punto { c: root.punto; }
            }
            Text {
                text: root.sub;
                color: Paleta.fg-3;
                font-size: 11.7px;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// La estantería: tantas columnas de al menos 124 px como quepan. Con `vista-y` y
// `vista-alto` (el desplazamiento y el alto del ScrollView que la contiene) solo existen las
// cajas que se ven, más un margen; sin ellos, todas.
component Estante inherits Rectangle {
    in property <[Juego]> juegos;
    in property <bool> explorar;
    in property <length> vista-y: 0;
    in property <length> vista-alto: 100000px;
    property <length> arriba: root.vista-y - root.y - 600px;
    property <length> abajo: root.vista-y - root.y + root.vista-alto + 600px;
    callback abrir(string);
    property <length> gap-x: 18px;
    property <length> gap-y: 22px;
    property <int> cols: Math.max(1, Math.floor((self.width + self.gap-x) / (124px + self.gap-x)));
    property <length> w: (self.width - (self.cols - 1) * self.gap-x) / self.cols;
    property <length> h: 19px + self.w * 1.5 + 7px + 34px + 7px + 16px;
    height: root.juegos.length == 0 ? 0 : Math.ceil(root.juegos.length / root.cols) * (root.h + root.gap-y) - root.gap-y;
    for j[i] in root.juegos: Rectangle {
        x: Math.mod(i, root.cols) * (root.w + root.gap-x);
        y: Math.floor(i / root.cols) * (root.h + root.gap-y);
        width: root.w;
        height: root.h;
        if Math.floor(i / root.cols) * (root.h + root.gap-y) + root.h > root.arriba && Math.floor(i / root.cols) * (root.h + root.gap-y) < root.abajo: Caja {
            width: parent.width;
            height: parent.height;
            juego: j;
            sub: root.explorar ? (j.instalado ? @tr("Instalado") : Util.estado(j.nivel)) : j.sub;
            con-punto: root.explorar && !j.instalado;
            punto: Util.nivel-color(j.nivel);
            clicked => { root.abrir(j.id); }
        }
    }
}

component Encabezado inherits HorizontalLayout {
    in property <string> text;
    in property <string> nota;
    spacing: 10px;
    alignment: start;
    Text {
        text: root.text;
        color: Paleta.fg;
        font-size: 15.75px;
        font-weight: 800;
        vertical-alignment: bottom;
    }
    if root.nota != "": Text {
        text: root.nota;
        color: Paleta.fg-3;
        font-size: 12.3px;
        font-weight: 600;
        vertical-alignment: bottom;
    }
}

component Subtitulo inherits Text {
    color: Paleta.fg;
    font-size: 13.5px;
    font-weight: 700;
}

// Texto que se puede seleccionar y copiar, como en una página: un TextInput de solo lectura,
// con Ctrl+C y un menú con clic derecho.
component TextoSel inherits TextInput {
    read-only: true;
    single-line: false;
    wrap: word-wrap;
    selection-background-color: Paleta.gold;
    selection-foreground-color: Paleta.gold-ink;
    ContextMenuArea {
        width: 100%;
        height: 100%;
        Menu {
            MenuItem {
                title: @tr("Copiar");
                activated => { root.copy(); }
            }
            MenuItem {
                title: @tr("Seleccionar todo");
                activated => { root.select-all(); }
            }
        }
    }
}

component Nota inherits TextoSel {
    color: Paleta.fg-2;
    font-size: 12.9px;
}

// Un enlace: subrayado fino que se vuelve dorado al pasar por encima.
component Enlace inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 13.2px;
    in property <int> font-weight: 400;
    callback clicked;
    width: t.preferred-width;
    height: t.preferred-height + 3px;
    // Como un enlace de Steam: se ilumina al pasar el ratón y se oscurece al pulsar.
    t := Text {
        y: 0;
        text: root.text;
        color: ta.pressed ? Paleta.gold : ta.has-hover ? Paleta.resalte : Paleta.fg;
        font-size: root.font-size;
        font-weight: root.font-weight;
        animate color { duration: Mov.rapido; }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: ta.has-hover ? Paleta.gold : Paleta.line;
        animate background { duration: Mov.rapido; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component BotonOro inherits Rectangle {
    in property <string> text;
    in property <bool> jugar;
    in property <bool> activo: true;
    callback clicked;
    height: 44px;
    width: fila.preferred-width;
    border-radius: 6px;
    // Más claro al pasar el ratón, más oscuro y hundido al pulsar.
    background: !root.activo ? Paleta.panel-2 : ta.pressed ? Paleta.gold.darker(0.18) : ta.has-hover ? Paleta.gold-hi : Paleta.gold;
    drop-shadow-color: #00000070;
    drop-shadow-offset-y: root.activo && !ta.pressed ? 2px : 0;
    drop-shadow-blur: root.activo && ta.has-hover && !ta.pressed ? 10px : root.activo && !ta.pressed ? 4px : 0;
    animate background, drop-shadow-offset-y, drop-shadow-blur { duration: Mov.rapido; }
    fila := HorizontalLayout {
        padding-left: 30px;
        padding-right: 30px;
        padding-top: ta.pressed ? 2px : 0;
        spacing: 10px;
        if root.jugar: VerticalLayout {
            alignment: center;
            Path {
                width: 14px;
                height: 16px;
                viewbox-width: 14;
                viewbox-height: 16;
                commands: "M 1 1.5 L 1 14.5 L 13 8 Z";
                fill: root.activo ? Paleta.gold-ink : Paleta.fg-3;
            }
        }
        Text {
            text: root.text;
            color: root.activo ? Paleta.gold-ink : Paleta.fg-3;
            font-size: 15.3px;
            font-weight: 800;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.activo;
        mouse-cursor: root.activo ? pointer : not-allowed;
        clicked => { root.clicked(); }
    }
}

component Boton inherits Rectangle {
    in property <string> text;
    // Dorado: la acción (Instalar), como el botón grande.
    in property <bool> oro;
    in property <bool> activo: true;
    callback clicked;
    height: 32px;
    width: t.preferred-width + 26px;
    border-radius: 6px;
    background: !root.activo ? Paleta.panel-2
        : root.oro ? (ta.pressed ? Paleta.gold.darker(0.18) : ta.has-hover ? Paleta.gold-hi : Paleta.gold)
        : ta.pressed ? Paleta.line : ta.has-hover ? Paleta.panel-2 : Paleta.panel;
    border-width: root.oro && root.activo ? 0 : Paleta.bw;
    border-color: ta.has-hover ? Paleta.fg-3 : Paleta.line;
    animate background, border-color { duration: Mov.rapido; }
    t := Text {
        y: (parent.height - self.height) / 2 + (ta.pressed ? 1px : 0);
        text: root.text;
        color: !root.activo ? Paleta.fg-3 : root.oro ? Paleta.gold-ink : Paleta.fg;
        font-size: 12.9px;
        font-weight: 700;
    }
    ta := TouchArea {
        enabled: root.activo;
        mouse-cursor: root.activo ? pointer : not-allowed;
        clicked => { root.clicked(); }
    }
}

// Un dato de la barra del juego: la etiqueta pequeña y el valor debajo.
component Dato inherits VerticalLayout {
    in property <string> etiqueta;
    in property <string> valor;
    in property <string> extra;
    in property <bool> con-punto;
    in property <color> punto;
    in property <bool> enlace;
    in property <bool> mal;
    callback clicked;
    spacing: 1px;
    alignment: center;
    Text {
        text: root.etiqueta;
        color: Paleta.fg-3;
        font-size: 11.7px;
    }
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        if root.con-punto: VerticalLayout {
            alignment: center;
            Punto { c: root.punto; }
        }
        if !root.enlace: Text {
            text: root.valor;
            color: root.mal ? Paleta.bad : Paleta.fg;
            font-size: 13.5px;
            font-weight: 700;
        }
        if root.enlace: Enlace {
            text: root.valor;
            font-size: 13.5px;
            font-weight: 700;
            clicked => { root.clicked(); }
        }
    }
    if root.extra != "": Text {
        text: root.extra;
        color: Paleta.fg-3;
        font-size: 11.7px;
    }
}

// Una lista definida: etiqueta a la izquierda y valor a la derecha, como <dl>.
component Def inherits HorizontalLayout {
    in property <string> etiqueta;
    in property <string> valor;
    in property <bool> mal;
    in property <bool> enlace;
    callback clicked;
    spacing: 18px;
    Text {
        width: 150px;
        text: root.etiqueta;
        color: Paleta.fg-3;
        font-size: 13.2px;
    }
    if !root.enlace: TextoSel {
        text: root.valor;
        color: root.mal ? Paleta.bad : Paleta.fg;
        font-size: 13.2px;
        horizontal-stretch: 1;
    }
    if root.enlace: HorizontalLayout {
        alignment: start;
        horizontal-stretch: 1;
        Enlace {
            text: root.valor;
            clicked => { root.clicked(); }
        }
    }
}

component FilaProyecto inherits Rectangle {
    in property <Proyecto> p;
    in property <bool> elegido;
    callback clicked;
    background: ta.pressed ? Paleta.line : ta.has-hover && !root.elegido ? Paleta.panel-2 : Paleta.panel;
    animate background { duration: Mov.rapido; }
    HorizontalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 16px;
        VerticalLayout {
            spacing: 3px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: root.p.nombre;
                    color: Paleta.fg;
                    font-size: 13.5px;
                    font-weight: 700;
                }
                if root.p.recomendado: Rectangle {
                    background: Paleta.gold;
                    border-radius: 4px;
                    width: rt.preferred-width + 12px;
                    rt := Text {
                        text: @tr("Recomendado");
                        color: Paleta.gold-ink;
                        font-size: 11.1px;
                        font-weight: 800;
                    }
                }
                if root.p.instalado: Rectangle {
                    border-radius: 4px;
                    border-width: Paleta.bw;
                    border-color: Paleta.ok;
                    width: it.preferred-width + 12px;
                    it := Text {
                        text: @tr("Instalado");
                        color: Paleta.ok;
                        font-size: 11.1px;
                        font-weight: 800;
                    }
                }
            }
            Text {
                text: @tr("{}, de {}", Util.metodo(root.p.metodo, root.p.toolchain), root.p.autor);
                color: Paleta.fg-3;
                font-size: 12.3px;
                wrap: word-wrap;
            }
            if root.p.motivo != "": Text {
                text: root.p.motivo;
                color: Paleta.fg-2;
                font-size: 12.3px;
                wrap: word-wrap;
            }
        }
        // La versión: la instalada (y si hay una nueva) o la última que publicó el proyecto.
        if root.p.instalado || root.p.ultima != "": VerticalLayout {
            alignment: center;
            spacing: 2px;
            width: 170px;
            Text {
                text: root.p.instalado ? root.p.version : root.p.ultima;
                color: Paleta.fg;
                font-size: 13.5px;
                font-weight: 700;
                horizontal-alignment: right;
            }
            Text {
                text: root.p.instalado ? (root.p.nueva != "" ? @tr("Hay {}", root.p.nueva) : @tr("Instalada")) : root.p.fecha-ultima;
                color: root.p.instalado && root.p.nueva != "" ? Paleta.gold : Paleta.fg-3;
                font-size: 12.3px;
                horizontal-alignment: right;
            }
        }
        VerticalLayout {
            alignment: center;
            width: 160px;
            HorizontalLayout {
                spacing: 6px;
                alignment: end;
                VerticalLayout {
                    alignment: center;
                    Punto { c: Util.nivel-color(root.p.nivel); }
                }
                Text {
                    text: Util.estado(root.p.nivel);
                    color: Paleta.fg-2;
                    font-size: 12.3px;
                    font-weight: 600;
                }
            }
        }
    }
    // El elegido lleva el borde dorado a la izquierda.
    Rectangle {
        x: 0;
        width: 3px;
        background: root.elegido ? Paleta.gold : ta.has-hover ? Paleta.gold.with-alpha(0.4) : transparent;
        animate background { duration: Mov.rapido; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Líneas entre filas, como `.lista > * + *`.
component Separador inherits Rectangle {
    height: Paleta.bw;
    background: Paleta.line;
}

component FilaDescarga inherits Rectangle {
    in property <Descarga> d;
    callback abrir;
    background: Paleta.panel;
    HorizontalLayout {
        padding: 14px;
        spacing: 16px;
        Rectangle {
            width: 54px;
            height: 81px;
            border-radius: 3px;
            clip: true;
            background: root.d.color.darker(0.6);
            if root.d.con-arte: Image {
                width: parent.width;
                height: parent.height;
                source: Portadas.portada(root.d.juego-id);
                image-fit: cover;
            }
        }
        VerticalLayout {
            spacing: 4px;
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.d.titulo;
                color: Paleta.fg;
                font-size: 13.5px;
                font-weight: 700;
            }
            Text {
                text: root.d.es-mod ? @tr("Mod de {}, de {}, desde Thunderstore", root.d.juego, root.d.autor) : root.d.juego;
                color: Paleta.fg-3;
                font-size: 12.3px;
            }
            if root.d.fase == 1 || root.d.fase == 2: HorizontalLayout {
                padding-top: 4px;
                Rectangle {
                    max-width: 420px;
                    height: 6px;
                    border-radius: 3px;
                    background: Paleta.panel-2;
                    Rectangle {
                        x: 0;
                        width: root.d.progreso < 0 ? 0 : parent.width * Math.clamp(root.d.progreso, 0, 1);
                        border-radius: 3px;
                        background: Paleta.gold;
                    }
                }
                Rectangle { }
            }
            Text {
                text: Util.descarga(root.d);
                color: root.d.fase == 4 ? Paleta.bad : root.d.fase == 3 ? Paleta.ok : Paleta.fg-3;
                font-size: 12.3px;
                wrap: word-wrap;
            }
        }
        if root.d.fase == 3: VerticalLayout {
            alignment: center;
            Boton {
                text: @tr("Abrir");
                clicked => { root.abrir(); }
            }
        }
    }
}

// Opciones juntas («Juegos | Mods», el tema, el idioma), como el selector de temas del diseño.
component Segmento inherits Rectangle {
    in property <[string]> opciones;
    in property <int> elegido;
    callback elegir(int);
    height: 34px;
    width: fila.preferred-width;
    border-radius: 8px;
    border-width: Paleta.bw;
    border-color: Paleta.line;
    background: Paleta.panel;
    fila := HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for o[i] in root.opciones: Rectangle {
            width: t.preferred-width + 26px;
            border-radius: 6px;
            background: i == root.elegido ? Paleta.fg : ta.has-hover ? Paleta.panel-2 : transparent;
            animate background { duration: Mov.rapido; }
            t := Text {
                text: o;
                color: i == root.elegido ? Paleta.bg : ta.has-hover ? Paleta.fg : Paleta.fg-2;
                font-size: 12.9px;
                font-weight: 700;
            }
            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.elegir(i); }
            }
        }
    }
}

// «Ordenar  Nombre ▾»: al pulsarlo se abre la lista de opciones.
component Desplegable inherits Rectangle {
    in property <string> etiqueta;
    in property <[string]> opciones;
    in property <int> elegido;
    callback elegir(int);
    height: 32px;
    width: fila.preferred-width;
    border-radius: 6px;
    background: ta.pressed ? Paleta.line : ta.has-hover ? Paleta.panel-2 : Paleta.panel;
    border-width: Paleta.bw;
    border-color: ta.has-hover ? Paleta.fg-3 : Paleta.line;
    animate background, border-color { duration: Mov.rapido; }
    fila := HorizontalLayout {
        padding-left: 12px;
        padding-right: 11px;
        spacing: 7px;
        Text {
            text: root.etiqueta;
            color: Paleta.fg-3;
            font-size: 12.9px;
            vertical-alignment: center;
        }
        Text {
            text: root.opciones[root.elegido];
            color: Paleta.fg;
            font-size: 12.9px;
            font-weight: 700;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Path {
                width: 10px;
                height: 6px;
                viewbox-width: 10;
                viewbox-height: 6;
                commands: "M 1 1 L 5 5 L 9 1";
                stroke: Paleta.fg-2;
                stroke-width: 1.6px;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { menu.show(); }
    }
    menu := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: Math.max(root.width, 200px);
        Rectangle {
            background: Paleta.panel;
            border-radius: 6px;
            border-width: Paleta.bw;
            border-color: Paleta.line;
            drop-shadow-color: #00000080;
            drop-shadow-blur: 14px;
            drop-shadow-offset-y: 4px;
            VerticalLayout {
                padding: 4px;
                for o[i] in root.opciones: Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    background: tao.has-hover ? Paleta.panel-2 : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text {
                            text: o;
                            color: i == root.elegido ? Paleta.fg : Paleta.fg-2;
                            font-size: 12.9px;
                            font-weight: i == root.elegido ? 700 : 400;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if i == root.elegido: VerticalLayout {
                            alignment: center;
                            Path {
                                width: 10px;
                                height: 8px;
                                viewbox-width: 10;
                                viewbox-height: 8;
                                commands: "M 1 4 L 4 7 L 9 1";
                                stroke: Paleta.gold;
                                stroke-width: 2px;
                            }
                        }
                    }
                    tao := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.elegir(i); }
                    }
                }
            }
        }
    }
}

// Un grupo de la columna de filtros: su título y las opciones con casilla, color y cuenta. Con
// más de diez, las demás se ven con «Ver más».
component GrupoFiltros inherits VerticalLayout {
    in property <GrupoFiltro> g;
    property <bool> abierto;
    spacing: 0;
    Text {
        text: Util.filtro-grupo(root.g.clave);
        color: Paleta.fg-3;
        font-size: 11.7px;
        font-weight: 800;
        height: 24px;
        vertical-alignment: center;
    }
    for o[i] in root.g.opciones: VerticalLayout {
        if i < 10 || root.abierto: Rectangle {
            height: 28px;
            border-radius: 4px;
            background: ta.has-hover ? Paleta.panel : transparent;
            accessible-role: checkbox;
            accessible-checkable: true;
            accessible-checked: o.marcada;
            accessible-label: Util.filtro-opcion(root.g.clave, o);
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 15px;
                        height: 15px;
                        border-radius: 3px;
                        background: o.marcada ? Paleta.gold : Paleta.panel-2;
                        border-width: o.marcada ? 0 : Paleta.bw;
                        border-color: ta.has-hover ? Paleta.fg-3 : Paleta.line;
                        if o.marcada: Path {
                            width: 9px;
                            height: 7px;
                            viewbox-width: 10;
                            viewbox-height: 8;
                            commands: "M 1 4 L 4 7 L 9 1";
                            stroke: Paleta.gold-ink;
                            stroke-width: 2px;
                        }
                    }
                }
                if o.marca > 0: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 9px;
                        height: 9px;
                        border-radius: o.marca == 2 ? 4.5px : 2px;
                        background: o.color;
                    }
                }
                Text {
                    text: Util.filtro-opcion(root.g.clave, o);
                    color: o.marcada || ta.has-hover ? Paleta.fg : Paleta.fg-2;
                    font-size: 12.6px;
                    font-weight: o.marcada ? 700 : 400;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: o.cuenta;
                    color: Paleta.fg-3;
                    font-size: 11.7px;
                    vertical-alignment: center;
                }
            }
            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { ExplorarUi.marcar(root.g.clave, o.clave, !o.marcada); }
            }
        }
    }
    if root.g.opciones.length > 10: HorizontalLayout {
        padding-top: 4px;
        padding-left: 4px;
        alignment: start;
        Enlace {
            text: root.abierto ? @tr("Ver menos") : @tr("Ver las {} restantes", root.g.opciones.length - 10);
            font-size: 12.3px;
            clicked => { root.abierto = !root.abierto; }
        }
    }
}

// La tarjeta de un mod: la franja con el color de la consola y el nombre del juego, el icono de
// Thunderstore en un cuadrado, y debajo nombre, autor, descargas y el botón. El cuadrado lleva a
// su página de Thunderstore.
component TarjetaMod inherits Rectangle {
    in property <ModRemoto> r;
    callback abrir-enlace(string);
    callback instalar();
    callback ver-juego();
    property <bool> encima: ta.has-hover && !ta.pressed;
    VerticalLayout {
        spacing: 6px;
        alignment: start;
        Rectangle {
            height: 19px + root.width;
            Rectangle {
                y: root.encima ? -4px : ta.pressed ? 1px : 0;
                height: parent.height;
                border-radius: 4px;
                background: Paleta.panel;
                drop-shadow-color: #00000090;
                drop-shadow-offset-y: root.encima ? 8px : 0;
                drop-shadow-blur: root.encima ? 18px : 0;
                animate y, drop-shadow-offset-y, drop-shadow-blur { duration: Mov.normal; easing: ease-out; }
                Rectangle {
                    border-radius: 4px;
                    clip: true;
                    VerticalLayout {
                        Rectangle {
                            height: 19px;
                            background: root.r.color;
                            Text {
                                x: 7px;
                                width: parent.width - 14px;
                                text: root.r.juego;
                                color: root.r.tinta;
                                font-size: 9.9px;
                                font-weight: 800;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        Rectangle {
                            clip: true;
                            background: @linear-gradient(160deg, root.r.color.darker(0.5) 0%, root.r.color.darker(2.4) 100%);
                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: Iconos.icono(root.r.icono, Iconos.listos);
                                image-fit: cover;
                                transform-origin: { x: self.width / 2, y: self.height / 2 };
                                transform-scale-x: root.encima ? 104% : 100%;
                                transform-scale-y: root.encima ? 104% : 100%;
                                animate transform-scale-x, transform-scale-y { duration: Mov.normal; easing: ease-out; }
                            }
                        }
                    }
                }
                Rectangle {
                    border-radius: 4px;
                    border-width: ta.has-hover ? 2px : Paleta.bw;
                    border-color: ta.has-hover ? Paleta.gold : Paleta.line;
                    animate border-color { duration: Mov.rapido; }
                }
            }
            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { FichaMod.abrir(root.r.entry, root.r.id); }
            }
        }
        Text {
            text: root.r.nombre;
            color: ta.has-hover ? Paleta.resalte : Paleta.fg;
            font-size: 12.9px;
            font-weight: 700;
            wrap: word-wrap;
            overflow: elide;
            // Siempre dos líneas de alto: así los botones de una fila quedan parejos.
            height: 34px;
            vertical-alignment: top;
            animate color { duration: Mov.rapido; }
        }
        Text {
            text: @tr("de {}", root.r.autor);
            color: Paleta.fg-3;
            font-size: 11.7px;
            overflow: elide;
        }
        Text {
            text: root.r.tam == "" ? @tr("{} descargas", root.r.descargas) : @tr("{} descargas · {}", root.r.descargas, root.r.tam);
            color: Paleta.fg-3;
            font-size: 11.7px;
            overflow: elide;
        }
        HorizontalLayout {
            padding-top: 2px;
            alignment: start;
            height: 32px;
            if root.r.estado == 0 || root.r.estado == 3: Boton {
                text: root.r.estado == 3 ? @tr("Actualizar") : @tr("Instalar");
                oro: true;
                clicked => { root.instalar(); }
            }
            if root.r.estado == 4: Boton {
                text: @tr("Ver el juego");
                clicked => { root.ver-juego(); }
            }
            if root.r.estado == 1: Text {
                text: @tr("Instalado");
                color: Paleta.ok;
                font-size: 12.6px;
                font-weight: 700;
                vertical-alignment: center;
            }
            if root.r.estado == 2: Text {
                text: @tr("En Descargas");
                color: Paleta.fg-2;
                font-size: 12.6px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }
}

// Las tarjetas de mods en cuadrícula, como el estante de los juegos: tantas columnas de al
// menos 150 px como quepan, y solo existen las que se ven (más un margen).
component CuadriculaMods inherits Rectangle {
    in property <[ModRemoto]> mods;
    in property <length> vista-y: 0;
    in property <length> vista-alto: 100000px;
    callback abrir-enlace(string);
    property <length> arriba: root.vista-y - root.y - 600px;
    property <length> abajo: root.vista-y - root.y + root.vista-alto + 600px;
    property <length> gap-x: 18px;
    property <length> gap-y: 26px;
    property <int> cols: Math.max(1, Math.floor((self.width + self.gap-x) / (150px + self.gap-x)));
    property <length> w: (self.width - (self.cols - 1) * self.gap-x) / self.cols;
    property <length> h: 19px + self.w + 6px + 34px + 6px + 15px + 6px + 15px + 6px + 32px;
    height: root.mods.length == 0 ? 0 : Math.ceil(root.mods.length / root.cols) * (root.h + root.gap-y) - root.gap-y;
    for r[i] in root.mods: Rectangle {
        x: Math.mod(i, root.cols) * (root.w + root.gap-x);
        y: Math.floor(i / root.cols) * (root.h + root.gap-y);
        width: root.w;
        height: root.h;
        if Math.floor(i / root.cols) * (root.h + root.gap-y) + root.h > root.arriba && Math.floor(i / root.cols) * (root.h + root.gap-y) < root.abajo: TarjetaMod {
            width: parent.width;
            height: parent.height;
            r: r;
            instalar => { ExplorarUi.instalar(r.entry, r.id); }
            ver-juego => { ExplorarUi.ver-juego(r.juego-id, r.entry); }
            abrir-enlace(u) => { root.abrir-enlace(u); }
        }
    }
}

// La cabecera de un estante del inicio: el color (de la consola), el título, cuántos hay y
// «Ver todos ›».
component TituloEstante inherits HorizontalLayout {
    in property <string> grupo;
    in property <string> clave;
    in property <string> titulo;
    in property <color> c;
    in property <bool> con-color;
    in property <int> cuenta;
    // Se puede mover a la izquierda o a la derecha (hay cajas fuera de la vista).
    in property <bool> puede-izq;
    in property <bool> puede-der;
    callback izq();
    callback der();
    spacing: 9px;
    if root.con-color: VerticalLayout {
        alignment: center;
        Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 2px;
            background: root.c;
        }
    }
    Text {
        text: Util.estante(root.clave, root.titulo);
        color: Paleta.fg;
        font-size: 15px;
        font-weight: 800;
        vertical-alignment: center;
    }
    Text {
        text: root.cuenta;
        color: Paleta.fg-3;
        font-size: 12.6px;
        font-weight: 700;
        vertical-alignment: center;
    }
    Rectangle { horizontal-stretch: 1; }
    Boton {
        text: "‹";
        activo: root.puede-izq;
        clicked => { root.izq(); }
    }
    Boton {
        text: "›";
        activo: root.puede-der;
        clicked => { root.der(); }
    }
    VerticalLayout {
        alignment: center;
        Enlace {
            text: @tr("Ver todos ›");
            font-size: 12.9px;
            font-weight: 700;
            clicked => { ExplorarUi.ver-todos(root.grupo, root.clave); }
        }
    }
}

// Un estante de juegos del inicio: una fila con las cajas que caben. Solo dibuja las cajas si
// está cerca de lo visible (`vista-y` y `vista-alto` del ScrollView).
component EstanteFila inherits VerticalLayout {
    in property <EstanteJuegos> e;
    in property <length> vista-y;
    in property <length> vista-alto;
    callback abrir(string);
    property <length> gap-x: 18px;
    property <int> cols: Math.max(1, Math.floor((self.width + self.gap-x) / (124px + self.gap-x)));
    property <length> w: (self.width - (self.cols - 1) * self.gap-x) / self.cols;
    property <length> h: 19px + self.w * 1.5 + 7px + 34px + 7px + 16px;
    property <bool> cerca: root.y + root.height > root.vista-y - 600px && root.y < root.vista-y + root.vista-alto + 600px;
    spacing: 12px;
    // Una página: las cajas que caben.
    property <length> paso: root.cols * (root.w + root.gap-x);
    TituloEstante {
        grupo: root.e.grupo;
        clave: root.e.clave;
        titulo: root.e.titulo;
        c: root.e.color;
        con-color: root.e.con-color;
        cuenta: root.e.cuenta;
        puede-izq: fl.content-x < 0;
        puede-der: fl.content-x > fl.width - fl.content-width + 1px;
        izq => { fl.content-x = Math.min(0, fl.content-x + root.paso); }
        der => { fl.content-x = Math.max(fl.width - fl.content-width, fl.content-x - root.paso); }
    }
    fl := Flickable {
        height: root.h;
        content-height: root.h;
        content-width: Math.max(self.width, root.e.juegos.length * (root.w + root.gap-x) - root.gap-x);
        for j[i] in root.e.juegos: Rectangle {
            x: i * (root.w + root.gap-x);
            width: root.w;
            height: root.h;
            // Solo las que se ven, y una de cada lado.
            if root.cerca && i * (root.w + root.gap-x) + root.w > -fl.content-x - root.w && i * (root.w + root.gap-x) < -fl.content-x + fl.width + root.w: Caja {
                width: parent.width;
                height: parent.height;
                juego: j;
                sub: j.instalado ? @tr("Instalado") : Util.estado(j.nivel);
                con-punto: !j.instalado;
                punto: Util.nivel-color(j.nivel);
                clicked => { root.abrir(j.id); }
            }
        }
    }
}

// Un estante de mods del inicio: una fila con las tarjetas que caben.
component EstanteModsFila inherits VerticalLayout {
    in property <EstanteMods> e;
    in property <length> vista-y;
    in property <length> vista-alto;
    callback abrir-enlace(string);
    property <length> gap-x: 18px;
    property <int> cols: Math.max(1, Math.floor((self.width + self.gap-x) / (150px + self.gap-x)));
    property <length> w: (self.width - (self.cols - 1) * self.gap-x) / self.cols;
    property <length> h: 19px + self.w + 6px + 34px + 6px + 15px + 6px + 15px + 6px + 32px;
    property <bool> cerca: root.y + root.height > root.vista-y - 600px && root.y < root.vista-y + root.vista-alto + 600px;
    spacing: 12px;
    property <length> paso: root.cols * (root.w + root.gap-x);
    TituloEstante {
        grupo: root.e.grupo;
        clave: root.e.clave;
        titulo: root.e.titulo;
        c: root.e.color;
        con-color: root.e.con-color;
        cuenta: root.e.cuenta;
        puede-izq: fl.content-x < 0;
        puede-der: fl.content-x > fl.width - fl.content-width + 1px;
        izq => { fl.content-x = Math.min(0, fl.content-x + root.paso); }
        der => { fl.content-x = Math.max(fl.width - fl.content-width, fl.content-x - root.paso); }
    }
    fl := Flickable {
        height: root.h;
        content-height: root.h;
        content-width: Math.max(self.width, root.e.mods.length * (root.w + root.gap-x) - root.gap-x);
        for r[i] in root.e.mods: Rectangle {
            x: i * (root.w + root.gap-x);
            width: root.w;
            height: root.h;
            if root.cerca && i * (root.w + root.gap-x) + root.w > -fl.content-x - root.w && i * (root.w + root.gap-x) < -fl.content-x + fl.width + root.w: TarjetaMod {
                width: parent.width;
                height: parent.height;
                r: r;
                instalar => { ExplorarUi.instalar(r.entry, r.id); }
                ver-juego => { ExplorarUi.ver-juego(r.juego-id, r.entry); }
                abrir-enlace(u) => { root.abrir-enlace(u); }
            }
        }
    }
}

// Un interruptor, como el del diseño: dorado si está encendido.// Un interruptor, como el del diseño: dorado si está encendido.
component Interruptor inherits Rectangle {
    in property <bool> on;
    in property <bool> activo: true;
    in property <string> etiqueta;
    callback toggled;
    width: 32px;
    height: 18px;
    border-radius: 9px;
    background: root.on ? (ta.has-hover ? Paleta.gold-hi : Paleta.gold) : ta.has-hover ? Paleta.line : Paleta.panel-2;
    border-width: root.on ? 0 : Paleta.bw;
    border-color: ta.has-hover ? Paleta.fg-3 : Paleta.line;
    opacity: root.activo ? 1 : 0.45;
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-label: root.etiqueta;
    animate background { duration: Mov.rapido; }
    Rectangle {
        x: root.on ? 17px : 3px;
        y: 3px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: root.on ? Paleta.gold-ink : Paleta.fg-3;
        animate x { duration: Mov.normal; }
    }
    ta := TouchArea {
        enabled: root.activo;
        mouse-cursor: root.activo ? pointer : default;
        clicked => { root.toggled(); }
    }
}

// Una casilla con su texto (las variantes de un mod).
component Casilla inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback toggled;
    height: 24px;
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-label: root.text;
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 4px;
                background: root.on ? Paleta.gold : Paleta.panel-2;
                border-width: root.on ? 0 : Paleta.bw;
                border-color: ta.has-hover ? Paleta.fg-3 : Paleta.line;
                if root.on: Path {
                    width: 10px;
                    height: 8px;
                    viewbox-width: 10;
                    viewbox-height: 8;
                    commands: "M 1 4 L 4 7 L 9 1";
                    stroke: Paleta.gold-ink;
                    stroke-width: 2px;
                }
            }
        }
        Text {
            text: root.text;
            color: ta.has-hover ? Paleta.fg : Paleta.fg-2;
            font-size: 12.9px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// Un campo de texto de una línea (el nombre de un perfil).
component Campo inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    height: 32px;
    border-radius: 6px;
    background: Paleta.panel;
    border-width: Paleta.bw;
    border-color: input.has-focus ? Paleta.gold : Paleta.line;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Rectangle {
            input := TextInput {
                color: Paleta.fg;
                font-size: 13px;
                vertical-alignment: center;
                single-line: true;
            }
            Text {
                visible: input.text == "";
                text: root.placeholder;
                color: Paleta.fg-3;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-alignment: left;
                width: parent.width;
            }
        }
    }
}

// Una fila de la lista de mods: lugar en el orden, interruptor, nombre y si está probado. Al
// pulsarla se abre: variantes, actualizar, Thunderstore y quitar.
component FilaMod inherits Rectangle {
    in property <ModFila> f;
    in property <bool> abierto;
    // Se está arrastrando: se ve más tenue.
    in property <bool> arrastrada;
    // Cuántos hay en el orden de carga, para apagar «Bajar» en el último.
    in property <int> activos;
    callback clicked;
    opacity: root.arrastrada ? 0.45 : 1;
    callback abrir-enlace(string);
    background: ta.has-hover && root.f.instalado ? Paleta.panel-2.mix(Paleta.panel, 0.35) : Paleta.panel;
    animate background { duration: Mov.rapido; }
    ta := TouchArea {
        enabled: root.f.instalado;
        mouse-cursor: root.f.instalado ? pointer : default;
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 12px;
            Text {
                width: 22px;
                text: root.f.orden > 0 ? root.f.orden : "";
                color: Paleta.fg-3;
                font-size: 12.3px;
                font-weight: 700;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            VerticalLayout {
                width: 34px;
                alignment: center;
                Interruptor {
                    on: root.f.activo;
                    activo: root.f.instalado;
                    etiqueta: @tr("Activar {}", root.f.nombre);
                    toggled => { ModsUi.activar(root.f.id, !root.f.activo); }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;
                HorizontalLayout {
                    spacing: 7px;
                    alignment: start;
                    Text {
                        text: root.f.nombre;
                        color: Paleta.fg;
                        font-size: 13.5px;
                        font-weight: 700;
                        overflow: elide;
                    }
                    if root.f.version != "": Text {
                        text: root.f.autor == "" ? root.f.version : @tr("{}, de {}", root.f.version, root.f.autor);
                        color: Paleta.fg-3;
                        font-size: 12.3px;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: root.f.fase == 0 ? @tr("En cola")
                        : root.f.fase == 1 ? (root.f.progreso >= 0 ? @tr("Bajando, {} %", Math.round(root.f.progreso * 100)) : @tr("Bajando"))
                        : root.f.fase == 2 ? @tr("Bajado. Descomprimiendo…")
                        : root.f.falta-elegir ? @tr("Trae {} variantes: elige cuál usar.", root.f.variantes.length)
                        : root.f.pide != "" ? @tr("Biblioteca. La pide {}, así que va antes.", root.f.pide)
                        : root.f.local && root.f.desc == "" ? @tr("Añadido a mano.")
                        : root.f.desc;
                    color: root.f.falta-elegir && root.f.fase < 0 ? Paleta.warn : Paleta.fg-3;
                    font-size: 11.9px;
                    wrap: word-wrap;
                }
                if root.f.fase == 1 || root.f.fase == 2: HorizontalLayout {
                    padding-top: 4px;
                    Rectangle {
                        max-width: 420px;
                        height: 6px;
                        border-radius: 3px;
                        background: Paleta.panel-2;
                        Rectangle {
                            x: 0;
                            width: root.f.progreso < 0 ? 0 : parent.width * Math.clamp(root.f.progreso, 0, 1);
                            border-radius: 3px;
                            background: Paleta.gold;
                        }
                    }
                    Rectangle { }
                }
            }
            if root.f.instalado: VerticalLayout {
                alignment: center;
                spacing: 3px;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: end;
                    VerticalLayout {
                        alignment: center;
                        Punto { c: root.f.local ? Paleta.fg-3 : root.f.probado ? Paleta.ok : Paleta.warn; }
                    }
                    Text {
                        text: root.f.local ? @tr("Tuyo") : root.f.probado ? @tr("Probado") : @tr("Sin probar");
                        color: Paleta.fg-2;
                        font-size: 11.7px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                if root.f.nueva != "": Text {
                    text: @tr("Nueva: {}", root.f.nueva);
                    color: Paleta.resalte;
                    font-size: 11.7px;
                    font-weight: 700;
                    horizontal-alignment: right;
                }
            }
        }
        if root.f.instalado && root.f.variantes.length > 0 && (root.abierto || root.f.falta-elegir): VerticalLayout {
            padding-left: 80px;
            spacing: 4px;
            Text {
                text: @tr("Variantes: marca la que quieres usar. Suele ser una sola, como la de tu mando.");
                color: Paleta.fg-2;
                font-size: 12.3px;
                wrap: word-wrap;
            }
            for v in root.f.variantes: Casilla {
                text: v.nombre;
                on: v.activa;
                toggled => { ModsUi.variante(root.f.id, v.archivo, !v.activa); }
            }
        }
        if root.f.instalado && root.abierto: HorizontalLayout {
            padding-left: 80px;
            spacing: 8px;
            alignment: start;
            if root.f.orden > 0: Boton {
                text: @tr("Subir");
                activo: root.f.orden > 1;
                clicked => { ModsUi.correr(root.f.id, -1); }
            }
            if root.f.orden > 0: Boton {
                text: @tr("Bajar");
                activo: root.f.orden < root.activos;
                clicked => { ModsUi.correr(root.f.id, 1); }
            }
            if root.f.nueva != "": Boton {
                text: @tr("Actualizar a {}", root.f.nueva);
                oro: true;
                clicked => { ModsUi.instalar(root.f.id); }
            }
            if root.f.pagina != "": Boton {
                text: @tr("Ficha del mod");
                clicked => { FichaMod.abrir(ModsUi.entry, root.f.id); }
            }
            Boton {
                text: @tr("Quitar");
                clicked => { ModsUi.quitar(root.f.id); }
            }
        }
    }
}

// Una fila de «Buscar mods»: nombre (lleva a Thunderstore), autor, descripción, descargas,
// tamaño y el botón.
component FilaRemoto inherits Rectangle {
    in property <ModRemoto> r;
    in property <bool> se-puede;
    callback abrir-enlace(string);
    callback instalar();
    background: Paleta.panel;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            alignment: center;
            HorizontalLayout {
                spacing: 7px;
                alignment: start;
                Enlace {
                    text: root.r.nombre;
                    font-size: 13.5px;
                    font-weight: 700;
                    clicked => { FichaMod.abrir(root.r.entry, root.r.id); }
                }
                Text {
                    text: @tr("{}, de {}", root.r.version, root.r.autor);
                    color: Paleta.fg-3;
                    font-size: 12.3px;
                    vertical-alignment: center;
                }
                if root.r.biblioteca: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 18px;
                        width: tb.preferred-width + 12px;
                        border-radius: 4px;
                        background: Paleta.panel-2;
                        tb := Text {
                            text: @tr("Biblioteca");
                            color: Paleta.fg-2;
                            font-size: 11.1px;
                            font-weight: 700;
                        }
                    }
                }
            }
            if root.r.desc != "": Text {
                text: root.r.desc;
                color: Paleta.fg-3;
                font-size: 11.9px;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: @tr("{} descargas", root.r.descargas);
                color: Paleta.fg-3;
                font-size: 11.7px;
                horizontal-alignment: right;
            }
            if root.r.tam != "": Text {
                text: root.r.tam;
                color: Paleta.fg-3;
                font-size: 11.7px;
                horizontal-alignment: right;
            }
        }
        VerticalLayout {
            width: 118px;
            alignment: center;
            if root.r.estado == 0 || root.r.estado == 3: HorizontalLayout {
                alignment: end;
                Boton {
                    text: root.r.estado == 3 ? @tr("Actualizar") : @tr("Instalar");
                    oro: true;
                    activo: root.se-puede;
                    clicked => { root.instalar(); }
                }
            }
            if root.r.estado == 1: Text {
                text: @tr("Instalado");
                color: Paleta.ok;
                font-size: 12.6px;
                font-weight: 700;
                horizontal-alignment: right;
            }
            if root.r.estado == 2: Text {
                text: @tr("En Descargas");
                color: Paleta.fg-2;
                font-size: 12.6px;
                font-weight: 700;
                horizontal-alignment: right;
            }
        }
    }
}

// La pestaña Mods de la página del juego, como en el diseño v3: el perfil arriba, la lista en
// orden de carga y abajo si el orden quedó resuelto o qué falla. «Buscar mods» cambia la lista
// por la de Thunderstore.
component PestanaMods inherits VerticalLayout {
    in property <Proyecto> p;
    in property <string> juego;
    // En la página Mods, todo; en la pestaña del juego, la lista (prender, apagar, ordenar) y un
    // botón a la página Mods para lo demás.
    in property <bool> completa: true;
    callback abrir-enlace(string);
    callback gestionar();
    // La búsqueda de Thunderstore solo está en la página Mods.
    property <bool> buscando: ModsUi.buscando && root.completa;
    property <bool> perfiles-abierto;
    property <string> abierto;
    // Arrastrar para ordenar: la fila que se arrastra y dónde caería (antes o después de cuál).
    property <string> arrastrando;
    property <string> soltar-en;
    property <bool> soltar-despues;
    spacing: 12px;

    if !root.p.con-mods: Nota {
        text: @tr("Todavía no hay mods fichados para {}.", root.juego);
    }

    // Arriba: el perfil y los dos botones.
    if root.p.con-mods && !root.buscando: HorizontalLayout {
        spacing: 18px;
        if ModsUi.cargado: Dato {
            etiqueta: @tr("Perfil");
            valor: ModsUi.perfil == "Principal" ? @tr("Principal") : ModsUi.perfil;
        }
        Rectangle { horizontal-stretch: 1; }
        if !root.completa: VerticalLayout {
            alignment: center;
            Boton {
                text: @tr("Gestionar en Mods ›");
                clicked => { root.gestionar(); }
            }
        }
        if root.completa: HorizontalLayout {
            spacing: 8px;
            alignment: end;
            if ModsUi.cargado && ModsUi.instalado: VerticalLayout {
                alignment: center;
                Boton {
                    text: root.perfiles-abierto ? @tr("Listo") : @tr("Cambiar de perfil");
                    clicked => { root.perfiles-abierto = !root.perfiles-abierto; }
                }
            }
            if ModsUi.cargado && ModsUi.instalado: VerticalLayout {
                alignment: center;
                Boton {
                    text: @tr("Añadir desde archivo…");
                    clicked => { ModsUi.anadir-archivo(); }
                }
            }
            VerticalLayout {
                alignment: center;
                Boton {
                    text: @tr("Buscar mods");
                    clicked => {
                        ModsUi.buscando = true;
                        root.perfiles-abierto = false;
                        ModsUi.buscar("");
                    }
                }
            }
        }
    }

    // Los perfiles: elegir, crear, renombrar y borrar.
    if root.p.con-mods && !root.buscando && root.perfiles-abierto: Rectangle {
        border-radius: 6px;
        border-width: Paleta.bw;
        border-color: Paleta.line;
        background: Paleta.panel;
        VerticalLayout {
            padding: 14px;
            spacing: 12px;
            VerticalLayout {
                spacing: 2px;
                for n in ModsUi.perfiles: Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    background: n == ModsUi.perfil ? Paleta.panel-2 : tap.has-hover ? Paleta.panel-2.with-alpha(0.5) : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 9px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 14px;
                                height: 14px;
                                border-radius: 7px;
                                border-width: n == ModsUi.perfil ? 0 : Paleta.bw;
                                border-color: Paleta.fg-3;
                                background: n == ModsUi.perfil ? Paleta.gold : transparent;
                                if n == ModsUi.perfil: Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: Paleta.gold-ink;
                                }
                            }
                        }
                        Text {
                            text: n == "Principal" ? @tr("Principal") : n;
                            color: n == ModsUi.perfil || tap.has-hover ? Paleta.fg : Paleta.fg-2;
                            font-size: 12.9px;
                            font-weight: n == ModsUi.perfil ? 700 : 400;
                            vertical-alignment: center;
                        }
                    }
                    tap := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { ModsUi.perfil-elegir(n); }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                campo := Campo {
                    width: 220px;
                    placeholder: @tr("Nombre del perfil");
                }
                Boton {
                    text: @tr("Nuevo, vacío");
                    clicked => {
                        ModsUi.perfil-nuevo(campo.text != "" ? campo.text : @tr("Perfil nuevo"), false);
                        campo.text = "";
                    }
                }
                Boton {
                    text: @tr("Copia de este");
                    clicked => {
                        ModsUi.perfil-nuevo(campo.text != "" ? campo.text : @tr("Perfil nuevo"), true);
                        campo.text = "";
                    }
                }
                Boton {
                    text: @tr("Renombrar este");
                    activo: campo.text != "";
                    clicked => {
                        ModsUi.perfil-renombrar(campo.text);
                        campo.text = "";
                    }
                }
                if ModsUi.perfiles.length > 1: Boton {
                    text: @tr("Borrar este");
                    clicked => { ModsUi.perfil-borrar(); }
                }
            }
            Nota {
                text: @tr("Cada perfil recuerda qué mods están activos y qué variantes elegiste. Al cambiar de perfil, Unricopie quita del juego los mods del otro y pone los de este.");
            }
        }
    }

    if root.p.con-mods && !root.buscando && !ModsUi.cargado: Nota {
        text: @tr("Leyendo tus mods…");
    }
    if root.p.con-mods && !root.buscando && ModsUi.cargado && !ModsUi.instalado: Nota {
        text: @tr("Instala el juego para ponerle mods. Mientras, puedes mirar los que hay en Thunderstore con «Buscar mods».");
    }
    if root.p.con-mods && !root.buscando && ModsUi.cargado && ModsUi.instalado && ModsUi.filas.length == 0: Nota {
        text: ModsUi.lista == 1 ? @tr("Todavía no le pusiste mods. En Thunderstore hay {} para este juego: búscalos con «Buscar mods».", ModsUi.total)
            : @tr("Todavía no le pusiste mods. Búscalos en Thunderstore con «Buscar mods».");
    }

    // Lo que acaba de pasar: arriba, para que se vea.
    if root.p.con-mods && !root.buscando && ModsUi.adoptados > 0: Nota {
        text: @tr("Tomamos {n} cambio que hiciste en el menú del juego (un mod apagado o el orden), para no pisarlo." | "Tomamos {n} cambios que hiciste en el menú del juego (mods apagados o el orden), para no pisarlos." % ModsUi.adoptados);
        color: Paleta.ok;
    }
    if root.p.con-mods && !root.buscando && ModsUi.anadidos > 0: Nota {
        text: @tr("Añadido {n} mod tuyo." | "Añadidos {n} mods tuyos." % ModsUi.anadidos);
        color: Paleta.ok;
    }

    // La lista, en el orden de carga.
    if root.p.con-mods && !root.buscando && ModsUi.filas.length > 0: Rectangle {
        border-radius: 6px;
        border-width: Paleta.bw;
        border-color: Paleta.line;
        clip: true;
        VerticalLayout {
            padding: Paleta.bw;
            for f[i] in ModsUi.filas: VerticalLayout {
                if i > 0: Separador { }
                Rectangle {
                    height: fila.preferred-height;
                    DropArea {
                        enabled: f.instalado;
                        can-drop(e) => {
                            if root.arrastrando == "" || root.arrastrando == f.id {
                                return DragAction.none;
                            }
                            root.soltar-en = f.id;
                            root.soltar-despues = e.position.y > self.height / 2;
                            return DragAction.move;
                        }
                        dropped(e) => {
                            ModsUi.mover(root.arrastrando, f.id, e.position.y > self.height / 2);
                            root.soltar-en = "";
                            return DragAction.move;
                        }
                        DragArea {
                            enabled: f.instalado && root.abierto != f.id;
                            allow-move: true;
                            data: ModsUi.dato-arrastre(f.id);
                            changed dragging => {
                                if self.dragging {
                                    root.arrastrando = f.id;
                                }
                            }
                            drag-finished(a) => {
                                root.arrastrando = "";
                                root.soltar-en = "";
                            }
                            fila := FilaMod {
                                width: parent.width;
                                height: parent.height;
                                f: f;
                                abierto: root.abierto == f.id;
                                arrastrada: root.arrastrando == f.id;
                                activos: ModsUi.activos;
                                clicked => { root.abierto = root.abierto == f.id ? "" : f.id; }
                                abrir-enlace(u) => { root.abrir-enlace(u); }
                            }
                        }
                    }
                    // Dónde caería: una línea dorada arriba o abajo de la fila.
                    if root.arrastrando != "" && root.soltar-en == f.id: Rectangle {
                        y: root.soltar-despues ? parent.height - 3px : 0;
                        height: 3px;
                        background: Paleta.gold;
                    }
                }
            }
        }
    }

    if root.p.con-mods && !root.buscando && ModsUi.instalado && ModsUi.cargado: Nota {
        text: @tr("Arrastra las filas para cambiar el orden. También puedes soltar aquí archivos .nrm, .rtz, .zip o .7z para añadirlos.");
    }

    // Abajo: si el orden quedó resuelto, o qué falla.
    if root.p.con-mods && !root.buscando && ModsUi.error.codigo != 0: HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Punto { c: Paleta.bad; }
        }
        Nota {
            text: ModsUi.error.codigo == 47 ? @tr("No se añadió: {}.", Util.error(ModsUi.error))
                : @tr("No se pudieron poner los mods en el juego: {}", Util.error(ModsUi.error));
            color: Paleta.bad;
            horizontal-stretch: 1;
        }
    }
    if root.p.con-mods && !root.buscando: VerticalLayout {
        spacing: 8px;
        for pr in ModsUi.problemas: HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Punto { c: Paleta.bad; }
            }
            Nota {
                text: Util.problema-mod(pr);
                color: Paleta.fg;
                horizontal-stretch: 1;
            }
            if pr.accion > 0 && pr.accion < 4: VerticalLayout {
                alignment: center;
                Boton {
                    text: pr.accion == 1 ? @tr("Instalarlo") : pr.accion == 2 ? @tr("Activarlo") : @tr("Actualizarlo");
                    clicked => {
                        if pr.accion == 2 {
                            ModsUi.activar(pr.id, true);
                        } else {
                            ModsUi.instalar(pr.id);
                        }
                    }
                }
            }
            if pr.accion == 4: VerticalLayout {
                alignment: center;
                Boton {
                    text: @tr("Que gane {}", pr.e);
                    clicked => { ModsUi.preferir(pr.id, pr.ids); }
                }
            }
            if pr.accion2 == 5: VerticalLayout {
                alignment: center;
                Boton {
                    text: @tr("Que siga ganando {}", pr.b);
                    clicked => { ModsUi.preferir(pr.id2, pr.ids); }
                }
            }
        }
    }
    if root.p.con-mods && !root.buscando && ModsUi.problemas.length == 0 && ModsUi.activos > 0 && ModsUi.error.codigo == 0: HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Punto { c: Paleta.ok; }
        }
        Text {
            text: @tr("Orden resuelto.");
            color: Paleta.fg;
            font-size: 12.9px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Nota {
            text: @tr("Cada biblioteca va antes del mod que la pide. Todo viene de Thunderstore y se pone en la carpeta de mods del juego con enlaces duros.");
            horizontal-stretch: 1;
        }
    }
    if root.p.con-mods && !root.buscando && ModsUi.instalado && ModsUi.carpeta != "": HorizontalLayout {
        spacing: 18px;
        Text {
            width: 150px;
            text: @tr("Carpeta de mods");
            color: Paleta.fg-3;
            font-size: 13.2px;
            vertical-alignment: center;
        }
        Text {
            text: ModsUi.carpeta;
            color: Paleta.fg;
            font-size: 13.2px;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
        }
        Boton {
            text: @tr("Abrir");
            clicked => { root.abrir-enlace(ModsUi.carpeta); }
        }
    }

    // «Buscar mods»: la lista de Thunderstore.
    if root.p.con-mods && root.buscando: HorizontalLayout {
        spacing: 10px;
        Buscador {
            horizontal-stretch: 1;
            placeholder: ModsUi.lista == 1 ? @tr("Buscar entre {} mods de Thunderstore", ModsUi.total) : @tr("Buscar en Thunderstore");
            edited(t) => { ModsUi.buscar(t); }
        }
        Boton {
            text: @tr("Volver a tus mods");
            clicked => {
                ModsUi.buscando = false;
                ModsUi.buscar("");
            }
        }
    }
    if root.p.con-mods && root.buscando && !ModsUi.instalado: Nota {
        text: @tr("Instala el juego para poder ponerle mods.");
        color: Paleta.warn;
    }
    if root.p.con-mods && root.buscando && ModsUi.lista == 0: Nota {
        text: @tr("Leyendo la lista de Thunderstore…");
    }
    if root.p.con-mods && root.buscando && ModsUi.lista == 2: HorizontalLayout {
        spacing: 10px;
        Nota {
            text: @tr("No se pudo leer la lista de Thunderstore. ¿Hay conexión?");
            color: Paleta.warn;
            horizontal-stretch: 1;
        }
        Boton {
            text: @tr("Reintentar");
            clicked => { ModsUi.recargar(); }
        }
    }
    if root.p.con-mods && root.buscando && ModsUi.lista == 1 && ModsUi.remotos.length == 0: Nota {
        text: @tr("Ningún mod coincide con la búsqueda.");
    }
    if root.p.con-mods && root.buscando && ModsUi.lista == 1 && ModsUi.remotos.length > 0: Rectangle {
        border-radius: 6px;
        border-width: Paleta.bw;
        border-color: Paleta.line;
        clip: true;
        VerticalLayout {
            padding: Paleta.bw;
            for r[i] in ModsUi.remotos: VerticalLayout {
                if i > 0: Separador { }
                FilaRemoto {
                    r: r;
                    se-puede: ModsUi.instalado;
                    instalar => { ModsUi.instalar(r.id); }
                    abrir-enlace(u) => { root.abrir-enlace(u); }
                }
            }
        }
    }
    if root.p.con-mods && root.buscando && ModsUi.lista == 1 && ModsUi.coinciden > ModsUi.remotos.length: HorizontalLayout {
        spacing: 12px;
        alignment: start;
        Boton {
            text: @tr("Ver más");
            clicked => { ModsUi.mas(); }
        }
        VerticalLayout {
            alignment: center;
            Nota { text: @tr("Ves {} de {}. También puedes buscar por nombre o autor.", ModsUi.remotos.length, ModsUi.coinciden); }
        }
    }
    if root.p.con-mods && root.buscando && ModsUi.lista == 1: Nota {
        text: @tr("De la comunidad {} de Thunderstore, de los más bajados a los menos. Unricopie todavía no probó ninguno: por eso dicen «Sin probar» en tu lista.", ModsUi.comunidad);
    }
}


// Una versión de la pestaña Versiones: la que está en uso (marcada) o una guardada, con «Usar
// esta» y «Borrar» (que pide confirmación). Avisa si algún mod activo pide una versión más nueva.
component FilaVersion inherits Rectangle {
    in property <string> version;
    in property <string> fecha;
    in property <bool> en-uso;
    in property <string> aviso-mod;
    in property <string> aviso-min;
    in property <int> aviso-mas;
    in property <bool> cambiando;
    in property <bool> ocupado;
    in property <bool> confirmar;
    callback usar;
    callback borrar;
    callback borrar-si;
    callback borrar-no;
    background: Paleta.panel;
    HorizontalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: root.version;
                    color: Paleta.fg;
                    font-size: 13.5px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                if root.en-uso: Rectangle {
                    border-radius: 4px;
                    border-width: Paleta.bw;
                    border-color: Paleta.ok;
                    width: tu.preferred-width + 12px;
                    tu := Text {
                        text: @tr("En uso");
                        color: Paleta.ok;
                        font-size: 11.1px;
                        font-weight: 800;
                    }
                }
            }
            Text {
                text: root.fecha;
                color: Paleta.fg-3;
                font-size: 12.3px;
            }
            if root.aviso-mod != "": Text {
                text: root.aviso-mas > 0 ? @tr("{} y {} mods más piden la versión {} o más nueva del juego.", root.aviso-mod, root.aviso-mas, root.aviso-min)
                    : @tr("{} pide la versión {} o más nueva del juego.", root.aviso-mod, root.aviso-min);
                color: Paleta.warn;
                font-size: 12.3px;
                wrap: word-wrap;
            }
        }
        if root.cambiando: VerticalLayout {
            alignment: center;
            Text {
                text: @tr("Cambiando a esta versión…");
                color: Paleta.fg-2;
                font-size: 12.9px;
                font-weight: 700;
            }
        }
        if !root.en-uso && !root.cambiando && !root.confirmar: VerticalLayout {
            alignment: center;
            Boton {
                text: @tr("Usar esta");
                activo: !root.ocupado;
                clicked => { root.usar(); }
            }
        }
        if !root.en-uso && !root.cambiando && !root.confirmar: VerticalLayout {
            alignment: center;
            Boton {
                text: @tr("Borrar");
                activo: !root.ocupado;
                clicked => { root.borrar(); }
            }
        }
        if root.confirmar: VerticalLayout {
            alignment: center;
            Text {
                text: @tr("Se borra del disco, sin vuelta atrás.");
                color: Paleta.warn;
                font-size: 12.3px;
            }
        }
        if root.confirmar: VerticalLayout {
            alignment: center;
            Boton {
                text: @tr("Borrarla");
                clicked => { root.borrar-si(); }
            }
        }
        if root.confirmar: VerticalLayout {
            alignment: center;
            Boton {
                text: @tr("Cancelar");
                clicked => { root.borrar-no(); }
            }
        }
    }
}

// La ficha de tienda: lo que se ve al abrir un juego desde Explorar, con las proporciones de la
// página de un juego en la tienda de Steam (aprobado el 10-11): ancho máximo y centrado; a la
// izquierda la captura grande (640×360 como mucho) con sus miniaturas, a la derecha la cápsula con
// lo esencial (300 de ancho); debajo, la caja para instalar, las formas de jugarlo y qué
// necesitas. El fondo del juego, apagado detrás de la cabecera. Desde la biblioteca, PaginaJuego.
component PaginaTienda inherits Rectangle {
    in property <Juego> j;
    in-out property <int> proyecto;
    in property <int> aviso;
    in property <string> aviso-a;
    in property <ErrorUi> aviso-error;
    callback instalar(string);
    callback jugar(string);
    callback abrir-enlace(string);
    callback elegir-copia(string);
    callback ver-en-biblioteca();
    callback volver();
    property <Proyecto> p: root.j.proyectos[root.proyecto];
    property <int> n: root.j.proyectos.length;
    // La captura grande.
    property <int> foto: 0;
    // El contenido: 640 + 28 + 300 como mucho; la columna izquierda, lo que queda.
    property <length> ancho: Math.min(root.width - 64px, 968px);
    property <length> izq: root.ancho - 328px;
    // Hay algo que mostrar en grande (capturas o el fondo). Si no, ahí va la descripción.
    property <bool> con-media: root.j.capturas.length > 0 || root.j.con-fondo;
    property <string> original: root.j.anio > 0 ? @tr("{}, {}", root.j.desarrollador, root.j.anio) : root.j.desarrollador;
    // Otro juego: la primera captura y desde arriba.
    changed j => {
        self.foto = 0;
        sv.content-y = 0;
    }
    init => { sv.content-y = 0; }
    sv := ScrollView {
        VerticalLayout {
            alignment: start;
            // La cabecera: el fondo apagado detrás, el título y el bloque de captura y cápsula.
            Rectangle {
                height: cab.preferred-height;
                clip: true;
                if root.j.con-fondo: Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.j.fondo;
                    image-fit: cover;
                    opacity: 0.16;
                }
                Rectangle {
                    background: @linear-gradient(180deg, Paleta.bg.with-alpha(0.15) 0%, Paleta.bg 100%);
                }
                cab := HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        width: root.ancho;
                        padding-top: 18px;
                        padding-bottom: 22px;
                        spacing: 10px;
                        HorizontalLayout {
                            alignment: start;
                            Enlace {
                                text: @tr("‹ Explorar");
                                font-size: 12.9px;
                                clicked => { root.volver(); }
                            }
                        }
                        Text {
                            text: root.j.nombre;
                            color: Paleta.fg;
                            font-size: 28px;
                            font-weight: 800;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 10px;
                                    height: 10px;
                                    border-radius: 2px;
                                    background: root.j.color;
                                }
                            }
                            Text {
                                text: root.original != "" ? @tr("{} · {}", root.j.consola-nombre, root.original) : root.j.consola-nombre;
                                color: Paleta.fg-2;
                                font-size: 13.5px;
                                vertical-alignment: center;
                            }
                        }
                        HorizontalLayout {
                            spacing: 28px;
                            padding-top: 6px;
                            alignment: start;
                            // Sin imágenes, la descripción del proyecto en su lugar.
                            if !root.con-media: VerticalLayout {
                                width: root.izq;
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    text: @tr("Sobre {}", root.p.nombre);
                                    color: Paleta.fg;
                                    font-size: 16px;
                                    font-weight: 800;
                                }
                                Nota {
                                    text: root.p.desc;
                                    font-size: 14px;
                                }
                            }
                            // La captura grande y sus miniaturas.
                            if root.con-media: VerticalLayout {
                                width: root.izq;
                                spacing: 8px;
                                alignment: start;
                                Rectangle {
                                    height: root.izq * 9 / 16;
                                    border-radius: 4px;
                                    clip: true;
                                    background: @linear-gradient(160deg, root.j.color.darker(0.4) 0%, root.j.color.darker(2.6) 100%);
                                    if root.j.capturas.length > 0: Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: root.j.capturas[root.foto];
                                        image-fit: cover;
                                    }
                                    if root.j.capturas.length == 0 && root.j.con-fondo: Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: root.j.fondo;
                                        image-fit: cover;
                                    }
                                    if root.j.capturas.length == 0 && !root.j.con-fondo: Text {
                                        width: parent.width - 48px;
                                        text: root.j.nombre;
                                        color: #ffffff;
                                        font-size: 24px;
                                        font-weight: 800;
                                        wrap: word-wrap;
                                        horizontal-alignment: center;
                                    }
                                }
                                if root.j.capturas.length > 1: HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    for c[i] in root.j.capturas: Rectangle {
                                        width: (root.izq - 5 * 6px) / 6;
                                        height: self.width * 9 / 16;
                                        border-radius: 3px;
                                        clip: true;
                                        Image {
                                            width: parent.width;
                                            height: parent.height;
                                            source: c;
                                            image-fit: cover;
                                            opacity: i == root.foto || tc.has-hover ? 1 : 0.55;
                                            animate opacity { duration: Mov.rapido; }
                                        }
                                        Rectangle {
                                            border-radius: 3px;
                                            border-width: i == root.foto ? 2px : Paleta.bw;
                                            border-color: i == root.foto ? Paleta.gold : Paleta.line;
                                        }
                                        tc := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.foto = i; }
                                        }
                                    }
                                }
                            }
                            // La cápsula: el arte, la descripción y lo esencial.
                            VerticalLayout {
                                width: 300px;
                                spacing: 12px;
                                alignment: start;
                                Rectangle {
                                    height: 140px;
                                    border-radius: 4px;
                                    clip: true;
                                    background: @linear-gradient(160deg, root.j.color.darker(0.4) 0%, root.j.color.darker(2.6) 100%);
                                    if root.j.con-fondo: Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: root.j.fondo;
                                        image-fit: cover;
                                    }
                                    if !root.j.con-fondo && root.j.con-arte: Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: root.j.portada;
                                        image-fit: contain;
                                    }
                                }
                                // Corta, como en Steam (seis líneas como mucho): el texto entero va
                                // abajo, en «Sobre».
                                if root.p.desc != "" && root.con-media: Rectangle {
                                    height: Math.min(corta.preferred-height, 6 * 19px);
                                    clip: true;
                                    corta := Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: root.p.desc;
                                        color: Paleta.fg-2;
                                        font-size: 13.2px;
                                        wrap: word-wrap;
                                        overflow: elide;
                                        vertical-alignment: top;
                                    }
                                }
                                Dato {
                                    etiqueta: @tr("Estado");
                                    valor: Util.estado(root.p.nivel);
                                    con-punto: true;
                                    punto: Util.nivel-color(root.p.nivel);
                                }
                                Dato {
                                    etiqueta: @tr("Opiniones");
                                    valor: root.p.op-total == 0 ? @tr("Todavía ninguna")
                                        : @tr("{} bien, {} con problemas, {} no arranca", root.p.op-bien, root.p.op-problemas, root.p.op-no);
                                    con-punto: root.p.op-total > 0;
                                    punto: root.p.op-no > root.p.op-bien ? Paleta.bad : root.p.op-problemas > root.p.op-bien ? Paleta.warn : Paleta.ok;
                                }
                                if root.p.ultima != "": Dato {
                                    etiqueta: @tr("Última versión");
                                    valor: root.p.ultima;
                                    extra: root.p.fecha-ultima;
                                }
                            }
                        }
                    }
                }
            }
            // Debajo: la caja para instalar, las formas de jugarlo y qué necesitas.
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    width: root.ancho;
                    padding-bottom: 36px;
                    spacing: 14px;
                    alignment: start;
                    Rectangle {
                        border-radius: 6px;
                        background: Paleta.panel;
                        border-width: Paleta.bw;
                        border-color: Paleta.line;
                        HorizontalLayout {
                            padding: 18px;
                            spacing: 14px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Text {
                                    text: root.p.instalado ? @tr("Jugar {}", root.p.nombre) : root.p.con-receta ? @tr("Instalar {}", root.p.nombre) : root.p.nombre;
                                    color: Paleta.fg;
                                    font-size: 17px;
                                    font-weight: 800;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: root.p.recomendado ? @tr("Recomendado · {}", Util.metodo(root.p.metodo, root.p.toolchain)) : Util.metodo(root.p.metodo, root.p.toolchain);
                                    color: root.p.recomendado ? Paleta.gold : Paleta.fg-3;
                                    font-size: 12.9px;
                                }
                                if root.aviso != 0: Nota {
                                    text: Util.aviso(root.aviso, root.aviso-a, root.aviso-error);
                                    color: Util.aviso-mal(root.aviso) ? Paleta.bad : Paleta.fg;
                                }
                                if !root.p.instalable && !root.p.instalado: Nota {
                                    text: root.p.sin-enlace ? @tr("Por prudencia, todavía no enlazamos este proyecto: lo haremos cuando su repositorio confirme que no trae código ni datos del juego.")
                                        : !root.p.con-receta ? @tr("Unricopie todavía no sabe instalar este proyecto: se baja desde su página. Sumamos juegos cada semana.")
                                        : @tr("Su receta todavía no dice qué abrir en este sistema, así que Unricopie aún no puede instalarlo.");
                                    color: root.p.con-receta ? Paleta.warn : Paleta.fg-2;
                                }
                            }
                            if root.p.instalado: VerticalLayout {
                                alignment: center;
                                Boton {
                                    text: @tr("Ver en la biblioteca");
                                    clicked => { root.ver-en-biblioteca(); }
                                }
                            }
                            if root.p.instalado: VerticalLayout {
                                alignment: center;
                                BotonOro {
                                    text: @tr("Jugar");
                                    jugar: true;
                                    activo: root.p.cambiando == "";
                                    clicked => { root.jugar(root.p.entry); }
                                }
                            }
                            if root.p.con-receta && !root.p.instalado: VerticalLayout {
                                alignment: center;
                                BotonOro {
                                    text: root.p.bajando ? @tr("En Descargas") : @tr("Instalar");
                                    activo: root.p.instalable && !root.p.bajando;
                                    clicked => { root.instalar(root.p.entry); }
                                }
                            }
                            if !root.p.con-receta && !root.p.instalado && !root.p.sin-enlace: VerticalLayout {
                                alignment: center;
                                BotonOro {
                                    text: @tr("Ver en GitHub");
                                    activo: true;
                                    clicked => { root.abrir-enlace("https://github.com/" + root.p.repo); }
                                }
                            }
                        }
                    }
                    Text {
                        text: root.n > 1 ? @tr("{} formas de jugarlo en PC", root.n) : @tr("Cómo jugarlo en PC");
                        color: Paleta.fg;
                        font-size: 16px;
                        font-weight: 800;
                    }
                    Rectangle {
                        border-radius: 6px;
                        border-width: Paleta.bw;
                        border-color: Paleta.line;
                        clip: true;
                        VerticalLayout {
                            padding: Paleta.bw;
                            for q[i] in root.j.proyectos: VerticalLayout {
                                if i > 0: Separador { }
                                FilaProyecto {
                                    p: q;
                                    elegido: i == root.proyecto;
                                    clicked => { root.proyecto = i; }
                                }
                            }
                        }
                    }
                    if root.n > 1: Nota {
                        text: @tr("La caja de arriba usa el proyecto marcado. Elige otro para ver el suyo.");
                    }
                    if root.con-media && root.p.desc != "": Text {
                        text: @tr("Sobre {}", root.p.nombre);
                        color: Paleta.fg;
                        font-size: 16px;
                        font-weight: 800;
                    }
                    if root.con-media && root.p.desc != "": Nota {
                        text: root.p.desc;
                        font-size: 14px;
                    }
                    Text {
                        text: @tr("Qué necesitas");
                        color: Paleta.fg;
                        font-size: 16px;
                        font-weight: 800;
                    }
                    VerticalLayout {
                        spacing: 8px;
                        if root.p.requisitos != "": Def { etiqueta: @tr("Qué copia"); valor: root.p.requisitos; }
                        if root.p.con-receta: Def { etiqueta: @tr("La tuya"); valor: Util.copia(root.p.copia, root.p.copia-nombre); mal: root.p.copia-falta; }
                        if root.p.pide-copia: HorizontalLayout {
                            alignment: start;
                            Boton {
                                text: root.p.copia-carpeta ? @tr("Elegir la carpeta del juego") : @tr("Elegir tu copia");
                                clicked => { root.elegir-copia(root.p.entry); }
                            }
                        }
                        Def { etiqueta: @tr("Autores"); valor: root.p.autor; }
                        if root.p.estrellas != "": Def { etiqueta: @tr("Estrellas en GitHub"); valor: root.p.estrellas; }
                        if !root.p.sin-enlace: Def {
                            etiqueta: @tr("Repositorio");
                            valor: "github.com/" + root.p.repo;
                            enlace: true;
                            clicked => { root.abrir-enlace("https://github.com/" + root.p.repo); }
                        }
                        if root.j.arte != 0: Def { etiqueta: @tr("Arte"); valor: Util.arte(root.j); }
                    }
                }
            }
        }
    }
}

// Una fila de datos de la ficha del mod: la clave a la izquierda y el valor a la derecha.
component FilaDatoMod inherits Rectangle {
    in property <string> clave;
    in property <string> valor;
    background: Paleta.panel;
    HorizontalLayout {
        padding-top: 9px;
        padding-bottom: 9px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        Text {
            text: root.clave;
            color: Paleta.fg-2;
            font-size: 12.9px;
            font-weight: 700;
            horizontal-stretch: 1;
        }
        Text {
            text: root.valor;
            color: Paleta.fg;
            font-size: 12.9px;
            font-weight: 700;
            horizontal-alignment: right;
        }
    }
}

// Los mods que necesita uno o que lo usan: cada uno, con su icono, lleva a su ficha.
component ListaModEnlaces inherits Rectangle {
    in property <[ModEnlace]> mods;
    border-radius: 6px;
    border-width: root.mods.length > 0 ? Paleta.bw : 0;
    border-color: Paleta.line;
    clip: true;
    VerticalLayout {
        padding: Paleta.bw;
        for m[i] in root.mods: VerticalLayout {
            if i > 0: Separador { }
            Rectangle {
                background: tm.has-hover && m.en-lista ? Paleta.panel-2 : Paleta.panel;
                HorizontalLayout {
                    padding: 10px;
                    spacing: 12px;
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: 4px;
                        clip: true;
                        background: Paleta.panel-2;
                        if m.icono != "": Image {
                            width: parent.width;
                            height: parent.height;
                            source: Iconos.icono(m.icono, Iconos.listos);
                            image-fit: cover;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text {
                            text: m.nombre;
                            color: tm.has-hover && m.en-lista ? Paleta.resalte : Paleta.fg;
                            font-size: 13.5px;
                            font-weight: 700;
                        }
                        Text {
                            text: m.autor != "" ? @tr("de {}", m.autor) : @tr("No está en la lista de este juego");
                            color: Paleta.fg-3;
                            font-size: 12.3px;
                        }
                    }
                    if m.detalle != "": Text {
                        text: m.detalle;
                        color: Paleta.fg-2;
                        font-size: 12.9px;
                        vertical-alignment: center;
                    }
                }
                tm := TouchArea {
                    mouse-cursor: m.en-lista ? pointer : default;
                    clicked => {
                        if m.en-lista {
                            FichaMod.abrir(FichaMod.r.entry, m.id);
                        }
                    }
                }
            }
        }
    }
}

// Un README (o un registro de cambios) partido en bloques: títulos, párrafos y listas con sus
// enlaces, código y rayas.
component TextoMd inherits VerticalLayout {
    in property <[BloqueMd]> bloques;
    // 0 leyéndose, 1 listo, 2 no se pudo leer (o no hay).
    in property <int> estado;
    in property <string> vacio;
    spacing: 10px;
    alignment: start;
    if root.estado == 0: Text {
        text: @tr("Leyendo…");
        color: Paleta.fg-3;
        font-size: 13.5px;
    }
    if root.estado == 2: Nota { text: root.vacio; }
    for b in root.bloques: VerticalLayout {
        padding-top: b.tipo >= 1 && b.tipo <= 3 ? 8px : 0;
        if b.tipo == 0: StyledText {
            text: b.texto;
            default-color: Paleta.fg;
            default-font-size: 14px;
            link-color: Paleta.gold;
            link-clicked(url) => { FichaMod.abrir-web(url); }
        }
        if b.tipo >= 1 && b.tipo <= 3: Text {
            text: b.plano;
            color: Paleta.fg;
            font-size: b.tipo == 1 ? 24px : b.tipo == 2 ? 19px : 16px;
            font-weight: 800;
            wrap: word-wrap;
        }
        if b.tipo == 4: Rectangle {
            border-radius: 4px;
            background: Paleta.panel;
            HorizontalLayout {
                padding: 12px;
                Text {
                    text: b.plano;
                    color: Paleta.fg-2;
                    font-size: 12.9px;
                    font-family: "Consolas";
                    wrap: word-wrap;
                }
            }
        }
        if b.tipo == 5: Separador { }
    }
}

// La ficha de un mod: una página como la de Thunderstore (10-11). A la izquierda, la cabecera
// (icono, nombre, descripción, autor y web) y las pestañas: Descripción (su README, con títulos
// y enlaces), Necesita y Lo usan (cada uno lleva a su ficha), Versiones y Cambios. A la derecha,
// Instalar y los datos. Los datos vienen de Thunderstore, que queda como enlace externo.
component PaginaMod inherits Rectangle {
    in property <string> volver-a;
    callback volver();
    callback abrir-enlace(string);
    property <length> ancho: Math.min(root.width - 64px, 1100px);
    property <length> izq: root.ancho - 328px;
    property <string> id: FichaMod.r.id;
    changed id => {
        sv.content-y = 0;
    }
    sv := ScrollView {
        VerticalLayout {
            alignment: start;
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    width: root.ancho;
                    padding-top: 18px;
                    padding-bottom: 36px;
                    spacing: 16px;
                    alignment: start;
                    HorizontalLayout {
                        alignment: start;
                        Enlace {
                            text: "‹ " + root.volver-a;
                            font-size: 12.9px;
                            clicked => { root.volver(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 28px;
                        alignment: start;
                        // La columna principal.
                        VerticalLayout {
                            width: root.izq;
                            spacing: 14px;
                            alignment: start;
                            HorizontalLayout {
                                spacing: 20px;
                                Rectangle {
                                    width: 112px;
                                    height: 112px;
                                    border-radius: 6px;
                                    clip: true;
                                    background: Paleta.panel;
                                    Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: Iconos.icono(FichaMod.r.icono, Iconos.listos);
                                        image-fit: cover;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    horizontal-stretch: 1;
                                    TextoSel {
                                        text: FichaMod.r.nombre;
                                        color: Paleta.fg;
                                        font-size: 28px;
                                        font-weight: 800;
                                    }
                                    Text {
                                        text: FichaMod.r.desc;
                                        color: Paleta.fg-2;
                                        font-size: 14px;
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        spacing: 18px;
                                        alignment: start;
                                        Enlace {
                                            text: @tr("de {} ↗", FichaMod.r.autor);
                                            font-size: 13.2px;
                                            clicked => { FichaMod.abrir-web(FichaMod.autor-url); }
                                        }
                                        if FichaMod.web != "": Enlace {
                                            text: FichaMod.web + " ↗";
                                            font-size: 13.2px;
                                            clicked => { FichaMod.abrir-web(FichaMod.web); }
                                        }
                                    }
                                    if FichaMod.r.juego != "": Text {
                                        text: @tr("Mod de {}", FichaMod.r.juego);
                                        color: Paleta.fg-3;
                                        font-size: 12.9px;
                                    }
                                }
                            }
                            Rectangle {
                                height: 44px;
                                HorizontalLayout {
                                    spacing: 2px;
                                    alignment: start;
                                    Pestana { text: @tr("Descripción"); tamano: 13.5px; activa: FichaMod.pestana == 0; clicked => { FichaMod.pestana = 0; } }
                                    Pestana { text: @tr("Necesita"); tamano: 13.5px; activa: FichaMod.pestana == 1; cuenta: FichaMod.necesita.length; clicked => { FichaMod.pestana = 1; } }
                                    Pestana { text: @tr("Lo usan"); tamano: 13.5px; activa: FichaMod.pestana == 2; cuenta: FichaMod.lo-usan.length; clicked => { FichaMod.pestana = 2; } }
                                    Pestana { text: @tr("Versiones"); tamano: 13.5px; activa: FichaMod.pestana == 3; cuenta: FichaMod.versiones.length; clicked => { FichaMod.pestana = 3; } }
                                    Pestana { text: @tr("Cambios"); tamano: 13.5px; activa: FichaMod.pestana == 4; clicked => { FichaMod.pestana = 4; } }
                                }
                                Separador { y: parent.height - self.height; }
                            }
                            if FichaMod.pestana == 0: TextoMd {
                                bloques: FichaMod.bloques;
                                estado: FichaMod.estado-readme;
                                vacio: @tr("No se pudo leer su descripción completa: está en Thunderstore.");
                            }
                            if FichaMod.pestana == 1 && FichaMod.necesita.length == 0: Nota { text: @tr("No necesita otros mods."); }
                            if FichaMod.pestana == 1: ListaModEnlaces { mods: FichaMod.necesita; }
                            if FichaMod.pestana == 2 && FichaMod.lo-usan.length == 0: Nota { text: @tr("Ningún otro mod lo usa."); }
                            if FichaMod.pestana == 2: ListaModEnlaces { mods: FichaMod.lo-usan; }
                            if FichaMod.pestana == 3: Rectangle {
                                border-radius: 6px;
                                border-width: Paleta.bw;
                                border-color: Paleta.line;
                                clip: true;
                                VerticalLayout {
                                    padding: Paleta.bw;
                                    for v[i] in FichaMod.versiones: VerticalLayout {
                                        if i > 0: Separador { }
                                        Rectangle {
                                            background: Paleta.panel;
                                            HorizontalLayout {
                                                padding-top: 10px;
                                                padding-bottom: 10px;
                                                padding-left: 14px;
                                                padding-right: 14px;
                                                spacing: 12px;
                                                Text {
                                                    text: v.version;
                                                    color: Paleta.fg;
                                                    font-size: 13.5px;
                                                    font-weight: 700;
                                                    width: 110px;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: v.fecha;
                                                    color: Paleta.fg-2;
                                                    font-size: 12.9px;
                                                    horizontal-stretch: 1;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: @tr("{} descargas", v.descargas);
                                                    color: Paleta.fg-3;
                                                    font-size: 12.9px;
                                                    vertical-alignment: center;
                                                }
                                                if v.tam != "": Text {
                                                    text: v.tam;
                                                    color: Paleta.fg-3;
                                                    font-size: 12.9px;
                                                    width: 80px;
                                                    horizontal-alignment: right;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            if FichaMod.pestana == 4: TextoMd {
                                bloques: FichaMod.cambios;
                                estado: FichaMod.estado-cambios;
                                vacio: @tr("Este mod no publica registro de cambios.");
                            }
                        }
                        // La columna de la derecha: Instalar y los datos.
                        VerticalLayout {
                            width: 300px;
                            spacing: 12px;
                            alignment: start;
                            if FichaMod.r.estado == 0 || FichaMod.r.estado == 3: BotonOro {
                                text: FichaMod.r.estado == 3 ? @tr("Actualizar") : @tr("Instalar");
                                activo: true;
                                clicked => { ExplorarUi.instalar(FichaMod.r.entry, FichaMod.r.id); }
                            }
                            if FichaMod.r.estado == 1 || FichaMod.r.estado == 2 || FichaMod.r.estado == 4: Text {
                                text: FichaMod.r.estado == 1 ? @tr("Instalado") : FichaMod.r.estado == 2 ? @tr("En Descargas") : @tr("Instala el juego para añadirle mods.");
                                color: FichaMod.r.estado == 1 ? Paleta.ok : Paleta.fg-2;
                                font-size: 14px;
                                font-weight: 700;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                alignment: start;
                                Enlace {
                                    text: @tr("Ver en Thunderstore ↗");
                                    font-size: 12.9px;
                                    clicked => { root.abrir-enlace(FichaMod.r.pagina); }
                                }
                            }
                            if FichaMod.paquete != "": Rectangle {
                                border-radius: 6px;
                                background: Paleta.panel;
                                border-width: Paleta.bw;
                                border-color: Paleta.line;
                                HorizontalLayout {
                                    padding: 10px;
                                    TextoSel {
                                        text: FichaMod.paquete;
                                        color: Paleta.fg-2;
                                        font-size: 12.9px;
                                    }
                                }
                            }
                            Rectangle {
                                border-radius: 6px;
                                border-width: Paleta.bw;
                                border-color: Paleta.line;
                                clip: true;
                                VerticalLayout {
                                    padding: Paleta.bw;
                                    FilaDatoMod { clave: @tr("Última versión"); valor: FichaMod.r.version; }
                                    Separador { }
                                    FilaDatoMod { clave: @tr("Actualizado"); valor: FichaMod.actualizado; }
                                    Separador { }
                                    FilaDatoMod { clave: @tr("Subido"); valor: FichaMod.subido; }
                                    Separador { }
                                    FilaDatoMod { clave: @tr("Descargas"); valor: FichaMod.r.descargas; }
                                    Separador { }
                                    FilaDatoMod { clave: @tr("Me gusta"); valor: FichaMod.me-gusta; }
                                    if FichaMod.r.tam != "": Separador { }
                                    if FichaMod.r.tam != "": FilaDatoMod { clave: @tr("Tamaño"); valor: FichaMod.r.tam; }
                                    Separador { }
                                    FilaDatoMod { clave: @tr("Lo usan"); valor: FichaMod.lo-usan.length == 1 ? @tr("1 mod") : @tr("{} mods", FichaMod.lo-usan.length); }
                                }
                            }
                            if FichaMod.categorias != "": Text {
                                text: @tr("Categorías");
                                color: Paleta.fg;
                                font-size: 14px;
                                font-weight: 800;
                            }
                            if FichaMod.categorias != "": Text {
                                text: FichaMod.categorias;
                                color: Paleta.fg-2;
                                font-size: 13.2px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: @tr("Los datos y la descripción vienen de Thunderstore.");
                                color: Paleta.fg-3;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}

// La página Mods: a la izquierda tus juegos instalados que llevan mods; a la derecha todo lo de
// los mods del elegido (perfiles, lista, orden, conflictos, buscar y añadir los tuyos).
component PaginaMods inherits Rectangle {
    in property <[Juego]> juegos;
    in property <string> elegido;
    in property <Proyecto> p;
    in property <string> juego;
    callback elegir(string);
    callback abrir-enlace(string);
    HorizontalLayout {
        Rectangle {
            width: 300px;
            background: Paleta.side;
            VerticalLayout {
                padding: 14px;
                spacing: 4px;
                alignment: start;
                Text {
                    text: @tr("Tus juegos con mods");
                    color: Paleta.fg-3;
                    font-size: 12.9px;
                    font-weight: 800;
                }
                for g in root.juegos: Rectangle {
                    height: 40px;
                    border-radius: 6px;
                    background: g.id == root.elegido ? Paleta.panel-2 : tg.has-hover ? Paleta.panel : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 2px;
                                background: g.color;
                            }
                        }
                        Text {
                            text: g.nombre;
                            color: Paleta.fg;
                            font-size: 13.5px;
                            font-weight: g.id == root.elegido ? 700 : 400;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                    tg := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.elegir(g.id); }
                    }
                }
                if root.juegos.length == 0: Nota {
                    text: @tr("Cuando instales un juego que admite mods (Zelda 64: Recompiled o Banjo: Recompiled), aquí los gestionas.");
                }
            }
        }
        if root.juegos.length > 0: ScrollView {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 24px;
                spacing: 14px;
                alignment: start;
                Text {
                    text: @tr("Mods de {}", root.juego);
                    color: Paleta.fg;
                    font-size: 22px;
                    font-weight: 800;
                }
                PestanaMods {
                    p: root.p;
                    juego: root.juego;
                    completa: true;
                    abrir-enlace(u) => { root.abrir-enlace(u); }
                }
            }
        }
    }
}

component PaginaJuego inherits Rectangle {
    in property <Juego> j;
    callback ir-mods(string);
    in-out property <int> proyecto;
    in-out property <int> pestana;
    in property <int> aviso;
    in property <string> aviso-a;
    in property <ErrorUi> aviso-error;
    callback instalar(string);
    callback jugar(string);
    callback abrir-enlace(string);
    callback elegir-copia(string);
    callback opinar(string, int);
    callback actualizar(string);
    callback volver(string, string);
    callback borrar-anterior(string, string);
    // La versión anterior que se está por borrar (pide confirmación).
    property <string> confirmar;
    property <Proyecto> p: root.j.proyectos[root.proyecto];
    property <int> n: root.j.proyectos.length;
    // Al abrir la pestaña Mods (o cambiar de juego con ella abierta) se piden los mods.
    property <string> mods-de: root.p.con-mods ? root.p.entry : "";
    changed mods-de => {
        if self.mods-de != "" {
            ModsUi.ver(self.mods-de);
        }
    }
    init => {
        if self.mods-de != "" {
            ModsUi.ver(self.mods-de);
        }
    }
    property <string> original: root.j.anio > 0 ? @tr("{}, {}", root.j.desarrollador, root.j.anio) : root.j.desarrollador;
    ScrollView {
        VerticalLayout {
            alignment: start;
            // El fondo y el logo, o el color de la consola y el nombre si no hay arte.
            Rectangle {
                height: 236px;
                clip: true;
                background: Paleta.panel;
                if root.j.con-fondo: Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.j.fondo;
                    image-fit: cover;
                }
                if root.j.con-logo: Image {
                    x: 24px;
                    y: parent.height - 18px - self.height;
                    width: Math.min(parent.width * 0.46, 380px);
                    height: 120px;
                    source: root.j.logo;
                    image-fit: contain;
                    horizontal-alignment: left;
                    vertical-alignment: bottom;
                }
                if !root.j.con-logo: Rectangle {
                    // Sin fondo, el color de la consola; con fondo, una sombra abajo para leer el nombre.
                    background: root.j.con-fondo
                        ? @linear-gradient(180deg, #00000000 35%, #000000c8 100%)
                        : @linear-gradient(160deg, root.j.color.darker(0.4) 0%, root.j.color.darker(2.6) 100%);
                    Text {
                        x: 24px;
                        y: parent.height - 22px - self.height;
                        width: Math.min(parent.width - 48px, 640px);
                        text: root.j.nombre;
                        color: #ffffff;
                        font-size: 34px;
                        font-weight: 800;
                        wrap: word-wrap;
                    }
                }
            }
            // La franja de la consola, como en la caja.
            Rectangle {
                height: 26px;
                background: root.j.color;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    Text {
                        text: root.j.consola-nombre;
                        color: root.j.tinta;
                        font-size: 11.7px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.original;
                        color: root.j.tinta;
                        opacity: 0.9;
                        font-size: 11.7px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        horizontal-stretch: 1;
                    }
                }
            }
            // La barra: el botón dorado y los datos que importan antes de jugar.
            Rectangle {
                background: Paleta.panel;
                FlexboxLayout {
                    padding-top: 14px;
                    padding-bottom: 14px;
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing-horizontal: 26px;
                    spacing-vertical: 14px;
                    cross-axis-alignment: center;
                    if root.p.con-receta || root.p.instalado: BotonOro {
                        text: root.p.instalado ? @tr("Jugar") : root.p.bajando ? @tr("En Descargas") : @tr("Instalar");
                        jugar: root.p.instalado;
                        activo: root.p.instalado ? root.p.cambiando == "" : (root.p.instalable && !root.p.bajando);
                        clicked => {
                            if root.p.instalado {
                                root.jugar(root.p.entry);
                            } else {
                                root.instalar(root.p.entry);
                            }
                        }
                    }
                    // Hay una versión oficial más nueva que la instalada. Se baja en Descargas; al
                    // terminar, cambia la carpeta guardando la de antes con tus partidas.
                    if root.p.instalado && root.p.nueva != "": Boton {
                        text: root.p.bajando ? @tr("Actualizando a {}…", root.p.nueva) : @tr("Actualizar a {}", root.p.nueva);
                        activo: !root.p.bajando;
                        clicked => { root.actualizar(root.p.entry); }
                    }
                    // Sin receta, Unricopie no lo instala: lleva al proyecto, que es de donde se baja.
                    if !root.p.con-receta && !root.p.instalado && !root.p.sin-enlace: BotonOro {
                        text: @tr("Ver en GitHub");
                        activo: true;
                        clicked => { root.abrir-enlace("https://github.com/" + root.p.repo); }
                    }
                    // El perfil de mods con el que se juega; crear, renombrar y borrar, en Mods.
                    if root.p.instalado && root.p.con-mods && ModsUi.entry == root.p.entry && ModsUi.perfiles.length > 0: Desplegable {
                        etiqueta: @tr("Perfil");
                        opciones: ModsUi.perfiles;
                        elegido: ModsUi.perfil-indice;
                        elegir(i) => { ModsUi.perfil-elegir(ModsUi.perfiles[i]); }
                    }
                    if !root.p.instalado: Dato {
                        etiqueta: @tr("Estado");
                        valor: Util.estado(root.p.nivel);
                        con-punto: true;
                        punto: Util.nivel-color(root.p.nivel);
                    }
                    if root.p.con-receta: Dato {
                        etiqueta: @tr("Tu copia");
                        valor: Util.copia(root.p.copia, root.p.copia-nombre);
                        mal: root.p.copia-falta;
                    }
                    if root.p.pide-copia: Boton {
                        text: root.p.copia-carpeta ? @tr("Elegir la carpeta del juego") : @tr("Elegir tu copia");
                        clicked => { root.elegir-copia(root.p.entry); }
                    }
                    Dato {
                        etiqueta: @tr("Opiniones");
                        valor: root.p.op-total == 0 ? @tr("Todavía ninguna")
                            : @tr("{} bien, {} con problemas, {} no arranca", root.p.op-bien, root.p.op-problemas, root.p.op-no);
                        con-punto: root.p.op-total > 0;
                        punto: root.p.op-no > root.p.op-bien ? Paleta.bad : root.p.op-problemas > root.p.op-bien ? Paleta.warn : Paleta.ok;
                    }
                    Dato {
                        etiqueta: root.n > 1 ? @tr("Proyecto ({} de {})", root.proyecto + 1, root.n) : @tr("Proyecto");
                        valor: root.p.nombre;
                        extra: @tr("de {}", root.p.autor);
                        enlace: !root.p.sin-enlace;
                        clicked => {
                            if !root.p.sin-enlace {
                                root.abrir-enlace("https://github.com/" + root.p.repo);
                            }
                        }
                    }
                }
                Separador { y: parent.height - self.height; }
            }
            // «¿Cómo te fue?»: abre en GitHub el formulario ya relleno; lo envía la persona. Sale
            // cuando esa versión ya se abrió; «Funciona bien» y «Con problemas», tras una hora de
            // juego o un día después (tiempo.rs).
            if root.p.instalado && root.p.op-abierto: Rectangle {
                background: Paleta.panel;
                FlexboxLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-bottom: 14px;
                    spacing-horizontal: 8px;
                    spacing-vertical: 8px;
                    cross-axis-alignment: center;
                    Text {
                        text: root.p.op-listo ? @tr("¿Cómo te fue con la versión {}?", root.p.version) : @tr("¿La versión {} no arranca?", root.p.version);
                        color: Paleta.fg;
                        font-size: 13.2px;
                        font-weight: 700;
                    }
                    if root.p.op-listo: Boton { text: @tr("Funciona bien"); clicked => { root.opinar(root.p.entry, 0); } }
                    if root.p.op-listo: Boton { text: @tr("Con problemas"); clicked => { root.opinar(root.p.entry, 1); } }
                    Boton { text: @tr("No arranca"); clicked => { root.opinar(root.p.entry, 2); } }
                    Text {
                        text: root.p.op-listo ? @tr("Se abre un formulario en GitHub ya relleno; lo envías tú.")
                            : @tr("Si funciona bien o con problemas te lo preguntamos tras una hora de juego o un día después de abrirlo. Se abre un formulario en GitHub ya relleno; lo envías tú.");
                        color: Paleta.fg-3;
                        font-size: 12.3px;
                    }
                }
            }
            if root.aviso != 0: Rectangle {
                background: Paleta.panel;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-bottom: 12px;
                    Nota {
                        text: Util.aviso(root.aviso, root.aviso-a, root.aviso-error);
                        color: Util.aviso-mal(root.aviso) ? Paleta.bad : Paleta.fg;
                    }
                }
            }
            if !root.p.instalable && !root.p.instalado: Rectangle {
                background: Paleta.panel;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-bottom: 12px;
                    Nota {
                        text: root.p.sin-enlace ? @tr("Por prudencia, todavía no enlazamos este proyecto: lo haremos cuando su repositorio confirme que no trae código ni datos del juego.")
                            : !root.p.con-receta ? @tr("Unricopie todavía no sabe instalar este proyecto: se baja desde su página. Sumamos juegos cada semana.")
                            : @tr("Su receta todavía no dice qué abrir en este sistema, así que Unricopie aún no puede instalarlo.");
                        color: root.p.con-receta ? Paleta.warn : Paleta.fg-2;
                    }
                }
            }
            Rectangle {
                height: 44px;
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    spacing: 2px;
                    alignment: start;
                    Pestana { text: @tr("Versiones"); tamano: 13.5px; activa: root.pestana == 0; clicked => { root.pestana = 0; } }
                    Pestana {
                        text: @tr("Mods");
                        tamano: 13.5px;
                        activa: root.pestana == 1;
                        cuenta: ModsUi.entry == root.p.entry ? ModsUi.filas.length : 0;
                        clicked => { root.pestana = 1; }
                    }
                    Pestana { text: @tr("Partidas"); tamano: 13.5px; activa: root.pestana == 2; clicked => { root.pestana = 2; } }
                    Pestana { text: @tr("Qué necesitas"); tamano: 13.5px; activa: root.pestana == 3; clicked => { root.pestana = 3; } }
                    Pestana { text: @tr("Acerca de"); tamano: 13.5px; activa: root.pestana == 4; clicked => { root.pestana = 4; } }
                }
                Separador { y: parent.height - self.height; }
            }
            VerticalLayout {
                padding-top: 18px;
                padding-bottom: 26px;
                padding-left: 24px;
                padding-right: 24px;
                spacing: 12px;
                if root.pestana == 0: Rectangle {
                    border-radius: 6px;
                    border-width: Paleta.bw;
                    border-color: Paleta.line;
                    clip: true;
                    VerticalLayout {
                        padding: Paleta.bw;
                        for q[i] in root.j.proyectos: VerticalLayout {
                            if i > 0: Separador { }
                            FilaProyecto {
                                p: q;
                                elegido: i == root.proyecto;
                                clicked => { root.proyecto = i; }
                            }
                        }
                    }
                }
                if root.pestana == 0: Nota {
                    text: root.n > 1
                        ? @tr("Hay {} proyectos que llevan este juego a PC. Elige uno para instalarlo; el botón de arriba usa el que está marcado.", root.n)
                        : @tr("Es el único proyecto del catálogo que lleva este juego a PC.");
                }
                // Las versiones de este proyecto en tu equipo: la que está en uso y las guardadas al
                // actualizar o al cambiar. Se puede pasar a cualquiera; los mods siguen igual.
                if root.pestana == 0 && root.p.instalado: VerticalLayout {
                    spacing: 8px;
                    padding-top: 10px;
                    Text {
                        text: @tr("Versiones de {}", root.p.nombre);
                        color: Paleta.fg;
                        font-size: 14.4px;
                        font-weight: 800;
                    }
                    Rectangle {
                        border-radius: 6px;
                        border-width: Paleta.bw;
                        border-color: Paleta.line;
                        clip: true;
                        VerticalLayout {
                            padding: Paleta.bw;
                            FilaVersion {
                                version: root.p.version;
                                fecha: root.p.instalada-el != "" ? @tr("Instalada el {}", root.p.instalada-el) : "";
                                en-uso: true;
                                aviso-mod: root.p.aviso-mod;
                                aviso-min: root.p.aviso-min;
                                aviso-mas: root.p.aviso-mas;
                            }
                            for a in root.p.anteriores: VerticalLayout {
                                Separador { }
                                FilaVersion {
                                    version: a.version;
                                    fecha: @tr("Instalada el {} · guardada el {}", a.instalada, a.guardada);
                                    aviso-mod: a.aviso-mod;
                                    aviso-min: a.aviso-min;
                                    aviso-mas: a.aviso-mas;
                                    cambiando: root.p.cambiando == a.id;
                                    ocupado: root.p.cambiando != "" || root.p.bajando;
                                    confirmar: root.confirmar == a.id;
                                    usar => { root.volver(root.p.entry, a.id); }
                                    borrar => { root.confirmar = a.id; }
                                    borrar-si => {
                                        root.confirmar = "";
                                        root.borrar-anterior(root.p.entry, a.id);
                                    }
                                    borrar-no => { root.confirmar = ""; }
                                }
                            }
                        }
                    }
                    if root.p.con-mods: Nota {
                        text: @tr("Al cambiar de versión, tus mods, su orden y tu perfil siguen igual: Unricopie los quita y los vuelve a poner.");
                    }
                    Nota {
                        text: @tr("Al actualizar, Unricopie guarda la versión de antes con tus partidas y tus ajustes, para que puedas volver a ella.");
                    }
                }
                if root.pestana == 1: PestanaMods {
                    p: root.p;
                    juego: root.j.nombre;
                    completa: false;
                    abrir-enlace(u) => { root.abrir-enlace(u); }
                    gestionar => { root.ir-mods(root.p.entry); }
                }
                if root.pestana == 2 && !root.p.instalado: Nota {
                    text: @tr("Cuando lo instales, aquí verás dónde guarda las partidas.");
                }
                if root.pestana == 2 && root.p.instalado: VerticalLayout {
                    spacing: 6px;
                    Def {
                        etiqueta: @tr("Dónde guarda");
                        valor: root.p.portable ? @tr("En la carpeta del juego (modo portable)") : @tr("Donde las guarda el juego; Unricopie no las mueve");
                    }
                    Def {
                        etiqueta: @tr("Carpeta del juego");
                        valor: root.p.carpeta;
                        enlace: true;
                        clicked => { root.abrir-enlace(root.p.carpeta); }
                    }
                }
                if root.pestana == 3: VerticalLayout {
                    spacing: 6px;
                    if root.p.requisitos != "": Def { etiqueta: @tr("Qué copia"); valor: root.p.requisitos; }
                    Def { etiqueta: @tr("La tuya"); valor: Util.copia(root.p.copia, root.p.copia-nombre); mal: root.p.copia-falta; }
                    if root.p.pide-copia: Nota {
                        text: @tr("Unricopie la comprueba con los hashes de la receta y la guarda una vez en tu biblioteca. Antes de abrir el juego se la deja donde la busca.");
                    }
                }
                if root.pestana == 4: VerticalLayout {
                    spacing: 12px;
                    if root.j.desc != "": HorizontalLayout {
                        Nota { text: root.j.desc; font-size: 14px; max-width: 760px; }
                        Rectangle { }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        Def { etiqueta: @tr("Autores"); valor: root.p.autor; }
                        Def {
                            etiqueta: @tr("Repositorio");
                            valor: "github.com/" + root.p.repo;
                            enlace: true;
                            clicked => { root.abrir-enlace("https://github.com/" + root.p.repo); }
                        }
                        Def { etiqueta: @tr("Cómo llega a PC"); valor: Util.metodo(root.p.metodo, root.p.toolchain); }
                        Def { etiqueta: @tr("Juego original"); valor: root.original; }
                        if root.j.arte != 0: Def { etiqueta: @tr("Arte"); valor: Util.arte(root.j); }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Unricopie";
    icon: @image-url("img/pastel.svg");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 560px;
    background: Paleta.bg;
    default-font-size: 15px;

    in-out property <Vista> vista: Vista.biblioteca;
    // De qué sección se abrió el juego, para marcarla arriba.
    in-out property <Vista> desde: Vista.biblioteca;
    // La barra lateral de tu biblioteca solo va en Biblioteca (y en un juego abierto desde ahí),
    // como en Steam: en Explorar, Descargas y Ajustes no está.
    property <bool> con-lateral: root.vista == Vista.biblioteca || (root.vista == Vista.juego && root.desde == Vista.biblioteca);
    // Lo escrito en su buscador, que se conserva aunque la barra se oculte.
    in-out property <string> busqueda;
    // Pasan archivos arrastrados por encima de la ventana, y a qué juego irían (vacío: a ninguno,
    // porque no está abierta la pestaña Mods de un juego instalado).
    in property <bool> soltando;
    in property <string> soltar-donde;
    // Esta versión de Unricopie y, si en recompendium.com hay una más nueva, cuál y su página.
    in property <string> version-app;
    in property <string> version-nueva;
    in property <string> version-pagina;
    // Lo instalado (en el orden elegido) y lo que se ve en la barra lateral (con la búsqueda).
    in property <[Juego]> biblioteca;
    in property <[Juego]> lateral;
    in property <int> instalados;
    // 0 instalado hace poco, 1 nombre, 2 consola.
    in property <int> orden-biblioteca;
    in property <int> total-catalogo;
    // Los que tienen al menos un proyecto con receta lista para este equipo.
    in property <int> instalables;
    // El juego abierto y qué proyecto y pestaña se ven.
    in property <Juego> actual;
    // La página Mods: los juegos instalados con mods, el elegido y su proyecto.
    in property <[Juego]> mods-juegos;
    in property <string> mods-elegido;
    in property <Proyecto> mods-proyecto;
    in property <string> mods-juego;
    callback abrir-mods();
    callback ir-mods(string);
    // De dónde se abrió la ficha del mod (adónde vuelve).
    in-out property <Vista> desde-mod: Vista.explorar;
    callback elegir-juego-mods(string);
    in-out property <int> proyecto;
    in-out property <int> pestana;
    // Ajustes.
    in property <string> raiz;
    in property <bool> portable;
    in property <string> idioma;
    // El catálogo: 0 leído, 1 no hay, 2 no se pudo leer; y si todas sus recetas se leyeron.
    in property <int> catalogo;
    in property <int> catalogo-proyectos;
    in property <bool> catalogo-ok;
    // La descarga en curso y las que esperan.
    in property <bool> descargando;
    in property <string> descarga-titulo;
    in property <int> en-cola;
    in property <float> progreso: -1;
    in property <[Descarga]> descargas;
    // Lo último que pasó con el juego abierto (instalar, la copia, abrirlo): ver Util.aviso.
    in property <int> aviso;
    in property <string> aviso-a;
    in property <ErrorUi> aviso-error;

    callback abrir(string);
    callback ordenar-biblioteca(int);
    callback buscar(string);
    callback abrir-enlace(string);
    callback instalar(string);
    callback jugar(string);
    callback elegir-copia(string);
    callback opinar(string, int);
    callback actualizar(string);
    callback volver(string, string);
    callback borrar-anterior(string, string);
    callback cambiar-idioma(string);
    // Se cambió el tema: guardarlo.
    callback guardar-ajustes();

    VerticalLayout {
        // Arriba: el pastel, las secciones y los ajustes.
        Rectangle {
            height: 46px;
            background: Paleta.side;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 22px;
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            width: 26px;
                            height: 26px;
                            source: @image-url("img/pastel.svg");
                        }
                    }
                    Text {
                        text: "Unricopie";
                        color: Paleta.fg;
                        font-size: 15px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    spacing: 4px;
                    Pestana {
                        text: @tr("Biblioteca");
                        activa: root.vista == Vista.biblioteca || (root.vista == Vista.juego && root.desde == Vista.biblioteca);
                        clicked => { root.vista = Vista.biblioteca; }
                    }
                    Pestana {
                        text: @tr("Explorar");
                        activa: root.vista == Vista.explorar || (root.vista == Vista.juego && root.desde == Vista.explorar) || (root.vista == Vista.ficha-mod && root.desde-mod == Vista.explorar);
                        clicked => { root.vista = Vista.explorar; }
                    }
                    Pestana {
                        text: @tr("Mods");
                        activa: root.vista == Vista.mods || (root.vista == Vista.ficha-mod && root.desde-mod == Vista.mods);
                        clicked => {
                            root.vista = Vista.mods;
                            root.abrir-mods();
                        }
                    }
                    Pestana {
                        text: @tr("Descargas");
                        activa: root.vista == Vista.descargas;
                        clicked => { root.vista = Vista.descargas; }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Pestana {
                    text: @tr("Ajustes");
                    tamano: 13.2px;
                    activa: root.vista == Vista.ajustes;
                    clicked => { root.vista = Vista.ajustes; }
                }
            }
            Separador { y: parent.height - self.height; }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            // La barra lateral: tu biblioteca. Solo en Biblioteca, como en Steam.
            if root.con-lateral: Rectangle {
                width: 236px;
                background: Paleta.side;
                VerticalLayout {
                    padding-top: 10px;
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    Buscador {
                        placeholder: @tr("Buscar en la biblioteca");
                        text <=> root.busqueda;
                        edited(t) => { root.buscar(t); }
                    }
                    HorizontalLayout {
                        padding-top: 6px;
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: @tr("Instalados");
                            color: Paleta.fg-3;
                            font-size: 12px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.instalados;
                            color: Paleta.fg-3;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }
                    if root.instalados == 0: HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: @tr("Todavía no hay ninguno. Los que instales aparecerán aquí.");
                            color: Paleta.fg-3;
                            font-size: 12.6px;
                            wrap: word-wrap;
                        }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: start;
                            spacing: 1px;
                            for j in root.lateral: Fila {
                                juego: j;
                                actual: root.vista == Vista.juego && root.actual.id == j.id;
                                clicked => { root.abrir(j.id); }
                            }
                        }
                    }
                }
                Rectangle {
                    x: parent.width - self.width;
                    width: Paleta.bw;
                    background: Paleta.line;
                }
            }

            // El centro: la sección elegida.
            Rectangle {
                horizontal-stretch: 1;
                background: Paleta.bg;
                if root.vista == Vista.biblioteca: ScrollView {
                    VerticalLayout {
                        padding-top: 20px;
                        padding-bottom: 28px;
                        padding-left: 22px;
                        padding-right: 22px;
                        spacing: 22px;
                        alignment: start;
                        HorizontalLayout {
                            spacing: 12px;
                            Encabezado {
                                text: @tr("Tus juegos");
                                nota: @tr("{n} instalado" | "{n} instalados" % root.instalados);
                            }
                            Rectangle { horizontal-stretch: 1; }
                            if root.instalados > 1: VerticalLayout {
                                alignment: center;
                                Desplegable {
                                    etiqueta: @tr("Ordenar");
                                    opciones: [@tr("Instalado hace poco"), @tr("Nombre"), @tr("Consola")];
                                    elegido: root.orden-biblioteca;
                                    elegir(i) => { root.ordenar-biblioteca(i); }
                                }
                            }
                        }
                        if root.instalados == 0: VerticalLayout {
                            spacing: 14px;
                            alignment: start;
                            Nota {
                                text: @tr("Todavía no has instalado ningún juego. En Explorar está el catálogo: {} juegos, {} ya se pueden instalar en este equipo.", root.total-catalogo, root.instalables);
                            }
                            HorizontalLayout {
                                alignment: start;
                                BotonOro {
                                    text: @tr("Ir a Explorar");
                                    clicked => { root.vista = Vista.explorar; }
                                }
                            }
                        }
                        Estante {
                            juegos: root.biblioteca;
                            abrir(id) => { root.abrir(id); }
                        }
                    }
                }
                if root.vista == Vista.explorar: sv-explorar := ScrollView {
                    contenido := VerticalLayout {
                        padding-top: 20px;
                        padding-bottom: 28px;
                        padding-left: 22px;
                        padding-right: 22px;
                        spacing: 26px;
                        alignment: start;
                        // Arriba: el título, el buscador y Juegos | Mods.
                        HorizontalLayout {
                            spacing: 14px;
                            if ExplorarUi.todos: VerticalLayout {
                                alignment: center;
                                Enlace {
                                    text: @tr("‹ Explorar");
                                    font-size: 13.5px;
                                    font-weight: 700;
                                    clicked => { ExplorarUi.volver(); }
                                }
                            }
                            Text {
                                text: ExplorarUi.mods ? @tr("Explorar mods") : @tr("Explorar el catálogo");
                                color: Paleta.fg;
                                font-size: 15.75px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                            // La nota cede su sitio: recortada, nunca ensancha la página.
                            Text {
                                text: ExplorarUi.mods
                                    ? @tr("{} mods de Thunderstore para {} juegos. Sumamos juegos cada semana.", ExplorarUi.total-mods, ExplorarUi.juegos-mods)
                                    : @tr("{} juegos en el catálogo de Recompendium; {} ya se pueden instalar en este equipo", root.total-catalogo, root.instalables);
                                color: Paleta.fg-3;
                                font-size: 12.3px;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                preferred-width: 0px;
                            }
                            VerticalLayout {
                                alignment: center;
                                Buscador {
                                    width: 260px;
                                    placeholder: ExplorarUi.mods ? @tr("Buscar mods") : @tr("Buscar en el catálogo");
                                    edited(t) => { ExplorarUi.buscar(t); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Segmento {
                                    opciones: [@tr("Juegos"), @tr("Mods")];
                                    elegido: ExplorarUi.mods ? 1 : 0;
                                    elegir(i) => { ExplorarUi.modo(i == 1); }
                                }
                            }
                        }
                        // El inicio: los estantes (Rust solo los llena ahí).
                        for e in ExplorarUi.estantes: EstanteFila {
                            e: e;
                            vista-y: -sv-explorar.content-y;
                            vista-alto: sv-explorar.visible-height;
                            abrir(id) => { root.abrir(id); }
                        }
                        for e in ExplorarUi.estantes-mods: EstanteModsFila {
                            e: e;
                            vista-y: -sv-explorar.content-y;
                            vista-alto: sv-explorar.visible-height;
                            abrir-enlace(u) => { root.abrir-enlace(u); }
                        }
                        if ExplorarUi.mods && ExplorarUi.cargando && !ExplorarUi.todos && ExplorarUi.estantes-mods.length == 0: Nota {
                            text: @tr("Leyendo las listas de Thunderstore…");
                        }
                        // «Ver todos»: la columna de filtros y la cuadrícula.
                        if ExplorarUi.todos: zona := HorizontalLayout {
                            spacing: 28px;
                            VerticalLayout {
                                width: 230px;
                                spacing: 18px;
                                alignment: start;
                                HorizontalLayout {
                                    Text {
                                        text: @tr("Filtros");
                                        color: Paleta.fg;
                                        font-size: 13.5px;
                                        font-weight: 800;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    if ExplorarUi.filtrado: VerticalLayout {
                                        alignment: center;
                                        Enlace {
                                            text: @tr("Quitar filtros");
                                            font-size: 12.3px;
                                            clicked => { ExplorarUi.limpiar(); }
                                        }
                                    }
                                }
                                for g in ExplorarUi.filtros: GrupoFiltros { g: g; }
                            }
                            derecha := VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 18px;
                                alignment: start;
                                HorizontalLayout {
                                    Text {
                                        text: ExplorarUi.mods ? @tr("{n} mod" | "{n} mods" % ExplorarUi.resultados) : @tr("{n} juego" | "{n} juegos" % ExplorarUi.resultados);
                                        color: Paleta.fg-2;
                                        font-size: 13.2px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Desplegable {
                                        etiqueta: @tr("Ordenar");
                                        opciones: ExplorarUi.mods
                                            ? [@tr("Más bajados"), @tr("Recién actualizados"), @tr("Nombre")]
                                            : [@tr("Nombre"), @tr("Más jugables"), @tr("Más nuevos"), @tr("Más viejos")];
                                        elegido: ExplorarUi.orden;
                                        elegir(i) => { ExplorarUi.ordenar(i); }
                                    }
                                }
                                if !ExplorarUi.mods: Estante {
                                    juegos: ExplorarUi.juegos;
                                    explorar: true;
                                    vista-y: -sv-explorar.content-y - zona.y - derecha.y;
                                    vista-alto: sv-explorar.visible-height;
                                    abrir(id) => { root.abrir(id); }
                                }
                                if ExplorarUi.mods: CuadriculaMods {
                                    mods: ExplorarUi.filas;
                                    vista-y: -sv-explorar.content-y - zona.y - derecha.y;
                                    vista-alto: sv-explorar.visible-height;
                                    abrir-enlace(u) => { root.abrir-enlace(u); }
                                }
                                if ExplorarUi.resultados == 0 && !(ExplorarUi.mods && ExplorarUi.cargando): Nota {
                                    text: @tr("Nada coincide con los filtros. Prueba a quitar alguno.");
                                }
                            }
                        }
                        if ExplorarUi.mods: Nota {
                            text: @tr("Para ponerle mods a un juego, primero instálalo. Los perfiles, el orden y las variantes de cada mod se manejan en la pestaña Mods del juego.");
                        }
                    }
                }
                if root.vista == Vista.descargas: ScrollView {
                    VerticalLayout {
                        padding-top: 20px;
                        padding-bottom: 28px;
                        padding-left: 22px;
                        padding-right: 22px;
                        spacing: 14px;
                        alignment: start;
                        Encabezado { text: @tr("Descargas"); }
                        if root.descargas.length == 0: Nota {
                            text: @tr("No hay descargas. Cuando instales un juego, aquí verás cómo va: la descarga, la comprobación del hash y la descompresión.");
                        }
                        if root.descargas.length > 0: Rectangle {
                            border-radius: 6px;
                            border-width: Paleta.bw;
                            border-color: Paleta.line;
                            clip: true;
                            VerticalLayout {
                                padding: Paleta.bw;
                                for d[i] in root.descargas: VerticalLayout {
                                    if i > 0: Separador { }
                                    FilaDescarga {
                                        d: d;
                                        abrir => { root.abrir(d.juego-id); }
                                    }
                                }
                            }
                        }
                    }
                }
                if root.vista == Vista.ajustes: VerticalLayout {
                    padding-top: 20px;
                    padding-left: 22px;
                    padding-right: 22px;
                    spacing: 16px;
                    alignment: start;
                    Encabezado { text: @tr("Ajustes"); }
                    Subtitulo { text: @tr("Idioma"); }
                    // Cada idioma con su propio nombre, como en todos lados.
                    HorizontalLayout {
                        alignment: start;
                        Segmento {
                            opciones: ["Español", "English"];
                            elegido: root.idioma == "en" ? 1 : 0;
                            elegir(i) => { root.cambiar-idioma(i == 1 ? "en" : "es"); }
                        }
                    }
                    Subtitulo { text: @tr("Tema"); }
                    HorizontalLayout {
                        alignment: start;
                        Segmento {
                            opciones: [@tr("Noche"), @tr("Día"), @tr("Alto contraste")];
                            elegido: Paleta.tema == Tema.dia ? 1 : Paleta.tema == Tema.contraste ? 2 : 0;
                            elegir(i) => {
                                Paleta.tema = i == 1 ? Tema.dia : i == 2 ? Tema.contraste : Tema.noche;
                                root.guardar-ajustes();
                            }
                        }
                    }
                    Subtitulo { text: @tr("Biblioteca"); }
                    VerticalLayout {
                        spacing: 6px;
                        Def {
                            etiqueta: @tr("Carpeta");
                            valor: root.raiz;
                            enlace: true;
                            clicked => { root.abrir-enlace(root.raiz); }
                        }
                        Def {
                            etiqueta: @tr("Modo");
                            valor: root.portable
                                ? @tr("Portable: hay un portable.txt junto al launcher, así que todo se guarda a su lado.")
                                : @tr("Normal, en la carpeta de datos del sistema. Con un portable.txt junto al launcher, todo se guardaría a su lado.");
                        }
                    }
                    Subtitulo { text: "Unricopie"; }
                    VerticalLayout {
                        spacing: 6px;
                        Def {
                            etiqueta: @tr("Versión");
                            valor: root.version-app;
                        }
                        if root.version-nueva != "": Def {
                            etiqueta: @tr("Hay una nueva");
                            valor: @tr("Unricopie {} ya está disponible", root.version-nueva);
                            enlace: true;
                            clicked => { root.abrir-enlace(root.version-pagina); }
                        }
                    }
                }
                // Desde Explorar, la ficha de tienda; desde la biblioteca, la del juego.
                if root.vista == Vista.juego && root.desde == Vista.explorar && root.actual.proyectos.length > 0: PaginaTienda {
                    j: root.actual;
                    proyecto <=> root.proyecto;
                    aviso: root.aviso;
                    aviso-a: root.aviso-a;
                    aviso-error: root.aviso-error;
                    instalar(e) => { root.instalar(e); }
                    jugar(e) => { root.jugar(e); }
                    abrir-enlace(u) => { root.abrir-enlace(u); }
                    elegir-copia(e) => { root.elegir-copia(e); }
                    ver-en-biblioteca => { root.desde = Vista.biblioteca; }
                    volver => { root.vista = Vista.explorar; }
                }
                if root.vista == Vista.ficha-mod: PaginaMod {
                    volver-a: root.desde-mod == Vista.mods ? @tr("Mods") : root.desde-mod == Vista.juego ? @tr("Volver al juego") : @tr("Explorar");
                    volver => { root.vista = root.desde-mod; }
                    abrir-enlace(u) => { root.abrir-enlace(u); }
                }
                if root.vista == Vista.mods: PaginaMods {
                    juegos: root.mods-juegos;
                    elegido: root.mods-elegido;
                    p: root.mods-proyecto;
                    juego: root.mods-juego;
                    elegir(id) => { root.elegir-juego-mods(id); }
                    abrir-enlace(u) => { root.abrir-enlace(u); }
                }
                if root.vista == Vista.juego && root.desde != Vista.explorar && root.actual.proyectos.length > 0: PaginaJuego {
                    j: root.actual;
                    ir-mods(e) => { root.ir-mods(e); }
                    proyecto <=> root.proyecto;
                    pestana <=> root.pestana;
                    aviso: root.aviso;
                    aviso-a: root.aviso-a;
                    aviso-error: root.aviso-error;
                    instalar(e) => { root.instalar(e); }
                    jugar(e) => { root.jugar(e); }
                    abrir-enlace(u) => { root.abrir-enlace(u); }
                    elegir-copia(e) => { root.elegir-copia(e); }
                    opinar(e, r) => { root.opinar(e, r); }
                    actualizar(e) => { root.actualizar(e); }
                    volver(e, id) => { root.volver(e, id); }
                    borrar-anterior(e, id) => { root.borrar-anterior(e, id); }
                }
            }
        }

        // Abajo: la descarga en curso y el estado del catálogo.
        Rectangle {
            height: 38px;
            background: Paleta.side;
            Separador { y: 0; }
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 14px;
                Text {
                    text: root.descargando ? @tr("Bajando {}", root.descarga-titulo)
                        : root.en-cola > 0 ? @tr("{} en cola", root.en-cola)
                        : @tr("Nada bajando");
                    color: Paleta.fg-2;
                    font-size: 12.6px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 0;
                }
                if root.progreso >= 0: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 220px;
                        height: 6px;
                        border-radius: 3px;
                        background: Paleta.panel-2;
                        Rectangle {
                            x: 0;
                            width: parent.width * Math.clamp(root.progreso, 0, 1);
                            border-radius: 3px;
                            background: Paleta.gold;
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                // Una versión nueva de Unricopie: el aviso lleva a su página. Nunca se actualiza sola.
                if root.version-nueva != "": HorizontalLayout {
                    spacing: 6px;
                    horizontal-stretch: 0;
                    VerticalLayout {
                        alignment: center;
                        Punto { c: Paleta.gold; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Enlace {
                            text: @tr("Unricopie {} ya está disponible", root.version-nueva);
                            font-size: 12.6px;
                            font-weight: 700;
                            clicked => { root.abrir-enlace(root.version-pagina); }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    horizontal-stretch: 0;
                    VerticalLayout {
                        alignment: center;
                        Punto { c: root.catalogo == 0 && root.catalogo-ok ? Paleta.ok : Paleta.warn; }
                    }
                    Text {
                        text: root.catalogo == 0 ? @tr("Catálogo: {} juegos, {} proyectos", root.total-catalogo, root.catalogo-proyectos)
                            : root.catalogo == 1 ? @tr("Sin catálogo (falta UNRICOPIE_CATALOGO)")
                            : @tr("No se pudo leer el catálogo");
                        color: Paleta.fg-2;
                        font-size: 12.6px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
    // Archivos arrastrados por encima: dónde caerían.
    if root.soltando: Rectangle {
        background: Paleta.bg.with-alpha(0.82);
        Rectangle {
            x: 40px;
            y: 40px;
            width: parent.width - 80px;
            height: parent.height - 80px;
            border-radius: 12px;
            border-width: 2px;
            border-color: root.soltar-donde != "" ? Paleta.gold : Paleta.line;
            Text {
                text: root.soltar-donde != "" ? @tr("Suelta para añadirlo a los mods de {}", root.soltar-donde)
                    : @tr("Para añadir mods, abre la pestaña Mods de un juego instalado y suéltalos ahí.");
                color: root.soltar-donde != "" ? Paleta.fg : Paleta.fg-2;
                font-size: 18px;
                font-weight: 700;
                wrap: word-wrap;
                horizontal-alignment: center;
                width: parent.width - 80px;
            }
        }
    }
}
